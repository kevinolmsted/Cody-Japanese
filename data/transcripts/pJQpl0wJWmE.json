   "start_time_text": "18:27",
   "text": "楽しいです"
  },
  {
   "end_ms": "1116960",
   "start_ms": "1112039",
   "start_time_text": "18:32",
   "text": "残念というかでなんとかできないかなー"
  },
  {
   "end_ms": "1122539",
   "start_ms": "1115640",
   "start_time_text": "18:35",
   "text": "みたいな"
  },
  {
   "end_ms": "1125120.0000000002",
   "start_ms": "1116960",
   "start_time_text": "18:36",
   "text": "そう考えてしたらなんか土地ごと買ってね"
  },
  {
   "end_ms": "1127780",
   "start_ms": "1122539",
   "start_time_text": "18:42",
   "text": "そっかそしたら取り壊しがなくなる周りの"
  },
  {
   "end_ms": "1131020",
   "start_ms": "1125120",
   "start_time_text": "18:45",
   "text": "土地とかもできれば"
  },
  {
   "end_ms": "1131020",
   "start_ms": "1127780",
   "start_time_text": "18:47",
   "text": "中心に"
  },
  {
   "end_ms": "1139280",
   "start_ms": "1133050",
   "start_time_text": "18:53",
   "text": "[音楽]"
  },
  {
   "end_ms": "1143260",
   "start_ms": "1135520",
   "start_time_text": "18:55",
   "text": "安い家賃で住んでもらってあとまあそう"
  },
  {
   "end_ms": "1143260",
   "start_ms": "1139280",
   "start_time_text": "18:59",
   "text": "いう人が年行った時に"
  },
  {
   "end_ms": "1148419",
   "start_ms": "1144200",
   "start_time_text": "19:04",
   "text": "老人ホームというか"
  },
  {
   "end_ms": "1152299",
   "start_ms": "1145480",
   "start_time_text": "19:05",
   "text": "みんな同じ仲間で言ったらあんまり"
  },
  {
   "end_ms": "1153880",
   "start_ms": "1148419",
   "start_time_text": "19:08",
   "text": "仕事してないからお金なんですね全部そう"
  },
  {
   "end_ms": "1156860",
   "start_ms": "1152299",
   "start_time_text": "19:12",
   "text": "なんですよ"
  },
  {
   "end_ms": "1162020.0000000002",
   "start_ms": "1153880",
   "start_time_text": "19:13",
   "text": "特にあの大河さん"
  },
  {
   "end_ms": "1163360",
   "start_ms": "1156860",
   "start_time_text": "19:16",
   "text": "で本当に我々二人とも心配はいてでそれを"
  },
  {
   "end_ms": "1166720",
   "start_ms": "1162020",
   "start_time_text": "19:22",
   "text": "先輩が"
  },
  {
   "end_ms": "1166719.9999999998",
   "start_ms": "1163360",
   "start_time_text": "19:23",
   "text": "売れてないから"
  },
  {
   "end_ms": "1173320",
   "start_ms": "1169480",
   "start_time_text": "19:29",
   "text": "もう厳しいじゃないですか"
  },
  {
   "end_ms": "1184480",
   "start_ms": "1173900",
   "start_time_text": "19:33",
   "text": "[笑い]"
  },
  {
   "end_ms": "1190059",
   "start_ms": "1177460",
   "start_time_text": "19:37",
   "text": "[音楽]"
  },
  {
   "end_ms": "1192500",
   "start_ms": "1184480",
   "start_time_text": "19:44",
   "text": "それのために色々とやっぱお金がね必要"
  },
  {
   "end_ms": "1194860",
   "start_ms": "1190059",
   "start_time_text": "19:50",
   "text": "そうですねアンケートでも取っていか"
  },
  {
   "end_ms": "1194860",
   "start_ms": "1192500",
   "start_time_text": "19:52",
   "text": "なきゃです"
  },
  {
   "end_ms": "1201679",
   "start_ms": "1196880",
   "start_time_text": "19:56",
   "text": "人に言ってないから"
  },
  {
   "end_ms": "1205178.9999999998",
   "start_ms": "1199120",
   "start_time_text": "19:59",
   "text": "本当はねネタで"
  },
  {
   "end_ms": "1210200",
   "start_ms": "1201679",
   "start_time_text": "20:01",
   "text": "稼げればいいんだけどネタも作れないしね"
  },
  {
   "end_ms": "1212120.0000000002",
   "start_ms": "1205179",
   "start_time_text": "20:05",
   "text": "だからスタッフさん的にはあんまりいい気"
  },
  {
   "end_ms": "1213520",
   "start_ms": "1210200",
   "start_time_text": "20:10",
   "text": "はしないだろうけどこれで細かく稼ぐしか"
  },
  {
   "end_ms": "1218379.9999999998",
   "start_ms": "1212120",
   "start_time_text": "20:12",
   "text": "ないんですよ"
  },
  {
   "end_ms": "1218379.9999999998",
   "start_ms": "1213520",
   "start_time_text": "20:13",
   "text": "全然全然私めちゃくちゃ好きです"
  },
  {
   "end_ms": "1226780",
   "start_ms": "1222580",
   "start_time_text": "20:22",
   "text": "今日いっぱいサービスいただいて"
  },
  {
   "end_ms": "1232660",
   "start_ms": "1227410",
   "start_time_text": "20:27",
   "text": "[音楽]"
  },
  {
   "end_ms": "1232660",
   "start_ms": "1229480",
   "start_time_text": "20:29",
   "text": "大丈夫そう"
  },
  {
   "end_ms": "1239720",
   "start_ms": "1235640",
   "start_time_text": "20:35",
   "text": "まもなくスタッフ来てお金取れないとかっ"
  },
  {
   "end_ms": "1241700",
   "start_ms": "1238220",
   "start_time_text": "20:38",
   "text": "てことになるんでディレクター入ってきて"
  },
  {
   "end_ms": "1243740",
   "start_ms": "1239720",
   "start_time_text": "20:39",
   "text": "すいませんプロジェクターとお話ししたん"
  },
  {
   "end_ms": "1248660",
   "start_ms": "1241700",
   "start_time_text": "20:41",
   "text": "ですけどそういうの全部なしで"
  },
  {
   "end_ms": "1250039",
   "start_ms": "1243740",
   "start_time_text": "20:43",
   "text": "チンしますあもう行きますすいません本当"
  },
  {
   "end_ms": "1252340.0000000002",
   "start_ms": "1248660",
   "start_time_text": "20:48",
   "text": "申し訳ないんですけどプロデューサーとお"
  },
  {
   "end_ms": "1255799",
   "start_ms": "1250039",
   "start_time_text": "20:50",
   "text": "話しさせていただいて"
  },
  {
   "end_ms": "1258260",
   "start_ms": "1252340",
   "start_time_text": "20:52",
   "text": "今回のこの先ほどの計算していただいた"
  },
  {
   "end_ms": "1260660",
   "start_ms": "1255799",
   "start_time_text": "20:55",
   "text": "金額に関してはお出しできないっていう"
  },
  {
   "end_ms": "1263740",
   "start_ms": "1258260",
   "start_time_text": "20:58",
   "text": "ことになりまし"
  },
  {
   "end_ms": "1263740",
   "start_ms": "1260660",
   "start_time_text": "21:00",
   "text": "たえどっからですか"
  },
  {
   "end_ms": "1279880",
   "start_ms": "1272140",
   "start_time_text": "21:12",
   "text": "作業しちゃってるから最初ないんですよ"
  },
  {
   "end_ms": "1279880",
   "start_ms": "1276880",
   "start_time_text": "21:16",
   "text": "ね"
  },
  {
   "end_ms": "1287260",
   "start_ms": "1281440",
   "start_time_text": "21:21",
   "text": "やっちゃった後に出せないそれをねその"
  },
  {
   "end_ms": "1290740",
   "start_ms": "1284240",
   "start_time_text": "21:24",
   "text": "おかしくないでそれを"
  },
  {
   "end_ms": "1290740",
   "start_ms": "1287260",
   "start_time_text": "21:27",
   "text": "それおかしいですか"
  },
  {
   "end_ms": "1330140",
   "start_ms": "1324159",
   "start_time_text": "22:04",
   "text": "ごめんなさいごめんなさいじゃあもうやっ"
  },
  {
   "end_ms": "1332179",
   "start_ms": "1327020",
   "start_time_text": "22:07",
   "text": "た分だけは出せませんこれ本当に"
  },
  {
   "end_ms": "1333559.0000000002",
   "start_ms": "1330140",
   "start_time_text": "22:10",
   "text": "打ち合わせとかアンケートとか"
  },
  {
   "end_ms": "1335740",
   "start_ms": "1332179",
   "start_time_text": "22:12",
   "text": "師走する意味なんかねえだろうお前なんか"
  },
  {
   "end_ms": "1335740",
   "start_ms": "1333559",
   "start_time_text": "22:13",
   "text": "よ"
  },
  {
   "end_ms": "1344418.9999999998",
   "start_ms": "1336280",
   "start_time_text": "22:16",
   "text": "やってんだからやった分は金出せと言っ"
  },
  {
   "end_ms": "1344419",
   "start_ms": "1339440",
   "start_time_text": "22:19",
   "text": "てんの連れて来いってプロデューサー全部"
  },
  {
   "end_ms": "1350860",
   "start_ms": "1345559",
   "start_time_text": "22:25",
   "text": "録音してるからなお前の今の会話全部録音"
  },
  {
   "end_ms": "1350860",
   "start_ms": "1348559",
   "start_time_text": "22:28",
   "text": "してるから"
  },
  {
   "end_ms": "1354879.9999999998",
   "start_ms": "1351080",
   "start_time_text": "22:31",
   "text": "世の中出すぞ"
  },
  {
   "end_ms": "1358539.0000000002",
   "start_ms": "1352880",
   "start_time_text": "22:32",
   "text": "フライデーとか出す"
  },
  {
   "end_ms": "1358539.0000000002",
   "start_ms": "1354880",
   "start_time_text": "22:34",
   "text": "それは違うじゃん"
  },
  {
   "end_ms": "1367120",
   "start_ms": "1359620",
   "start_time_text": "22:39",
   "text": "金の亡者春日さんってな出してやるぞお前"
  },
  {
   "end_ms": "1370520",
   "start_ms": "1364100",
   "start_time_text": "22:44",
   "text": "それはちょっとおかしいじゃん"
  },
  {
   "end_ms": "1372620",
   "start_ms": "1367120",
   "start_time_text": "22:47",
   "text": "それやりすぎだろそれもう高く売れちゃう"
  },
  {
   "end_ms": "1373639.9999999998",
   "start_ms": "1370520",
   "start_time_text": "22:50",
   "text": "よこれ実際にさ"
  },
  {
   "end_ms": "1376820",
   "start_ms": "1372620",
   "start_time_text": "22:52",
   "text": "巻き上げてるわけじゃないんだからね"
  },
  {
   "end_ms": "1380059.0000000002",
   "start_ms": "1373640",
   "start_time_text": "22:53",
   "text": "そんないくらでも何のために集めようとし"
  },
  {
   "end_ms": "1384760",
   "start_ms": "1376820",
   "start_time_text": "22:56",
   "text": "てんだよ何のためにこんなきったね"
  },
  {
   "end_ms": "1384760",
   "start_ms": "1380059",
   "start_time_text": "23:00",
   "text": "集めようとしてんだよお前はお金の"
  },
  {
   "end_ms": "1392299.0000000002",
   "start_ms": "1387919",
   "start_time_text": "23:07",
   "text": "それは別にいいじゃないとにかく金が必要"
  },
  {
   "end_ms": "1395740",
   "start_ms": "1390140",
   "start_time_text": "23:10",
   "text": "なんです"
  },
  {
   "end_ms": "1395740",
   "start_ms": "1392299",
   "start_time_text": "23:12",
   "text": "どんな機会に集めてんだよ"
  },
  {
   "end_ms": "1409480",
   "start_ms": "1402460",
   "start_time_text": "23:22",
   "text": "どうにもならないものあるそのままいい"
  },
  {
   "end_ms": "1409480",
   "start_ms": "1405200",
   "start_time_text": "23:25",
   "text": "じゃない何のために金必要なんだよ"
  },
  {
   "end_ms": "1415719.9999999998",
   "start_ms": "1412360",
   "start_time_text": "23:32",
   "text": "土下座しろよ"
  },
  {
   "end_ms": "1423379.9999999998",
   "start_ms": "1416120",
   "start_time_text": "23:36",
   "text": "じゃあ土下座して"
  },
  {
   "end_ms": "1425060",
   "start_ms": "1419000",
   "start_time_text": "23:39",
   "text": "そしたら今の録音世の中に出さねえでやる"
  },
  {
   "end_ms": "1428230",
   "start_ms": "1423380",
   "start_time_text": "23:43",
   "text": "よ"
  },
  {
   "end_ms": "1428230",
   "start_ms": "1425060",
   "start_time_text": "23:45",
   "text": "[音楽]"
  },
  {
   "end_ms": "1435940",
   "start_ms": "1431780",
   "start_time_text": "23:51",
   "text": "金のためだけじゃない"
  },
  {
   "end_ms": "1439059",
   "start_ms": "1434840",
   "start_time_text": "23:54",
   "text": "守りたいもの"
  },
  {
   "end_ms": "1439059",
   "start_ms": "1435940",
   "start_time_text": "23:55",
   "text": "人それぞれ"
  },
  {
   "end_ms": "1452659",
   "start_ms": "1447159",
   "start_time_text": "24:07",
   "text": "名作になるんだ土下座したら決して消して"
  },
  {
   "end_ms": "1454659",
   "start_ms": "1450679",
   "start_time_text": "24:10",
   "text": "くれよそしたら"
  },
  {
   "end_ms": "1457960",
   "start_ms": "1452659",
   "start_time_text": "24:12",
   "text": "消せよ"
  },
  {
   "end_ms": "1461620.0000000002",
   "start_ms": "1454659",
   "start_time_text": "24:14",
   "text": "どうしたらあかん絶対"
  },
  {
   "end_ms": "1461620.0000000002",
   "start_ms": "1457960",
   "start_time_text": "24:17",
   "text": "土下座で済むんだから"
  },
  {
   "end_ms": "1466299",
   "start_ms": "1463220",
   "start_time_text": "24:23",
   "text": "大丈夫大丈夫"
  },
  {
   "end_ms": "1469600",
   "start_ms": "1464539",
   "start_time_text": "24:24",
   "text": "守りたいものがあるから私大丈夫"
  },
  {
   "end_ms": "1469600",
   "start_ms": "1466299",
   "start_time_text": "24:26",
   "text": "ありがとうありがとう"
  },
  {
   "end_ms": "1485079",
   "start_ms": "1481820",
   "start_time_text": "24:41",
   "text": "[音楽]"
  },
  {
   "end_ms": "1495359",
   "start_ms": "1491980",
   "start_time_text": "24:51",
   "text": "[拍手]"
  },
  {
   "end_ms": "1506299",
   "start_ms": "1499539",
   "start_time_text": "24:59",
   "text": "大丈夫大丈夫本当に"
  },
  {
   "end_ms": "1509380",
   "start_ms": "1502720",
   "start_time_text": "25:02",
   "text": "大事なもの食べたから大丈夫大丈夫心配し"
  },
  {
   "end_ms": "1509379.9999999998",
   "start_ms": "1506299",
   "start_time_text": "25:06",
   "text": "てくれてありがとう心配せんでありがとう"
  },
  {
   "end_ms": "1516419.9999999998",
   "start_ms": "1513080",
   "start_time_text": "25:13",
   "text": "[音楽]"
  },
  {
   "end_ms": "1524109",
   "start_ms": "1517460",
   "start_time_text": "25:17",
   "text": "道の途中道の途中のだけだ"
  },
  {
   "end_ms": "1524109",
   "start_ms": "1521050",
   "start_time_text": "25:21",
   "text": "[音楽]"
  },
  {
   "end_ms": "1536980",
   "start_ms": "1530679",
   "start_time_text": "25:30",
   "text": "気持ちが乗ってんな大河さんのため大河"
  },
  {
   "end_ms": "1536979.9999999998",
   "start_ms": "1534620",
   "start_time_text": "25:34",
   "text": "さん食べたい"
  },
  {
   "end_ms": "1547429.9999999998",
   "start_ms": "1539330",
   "start_time_text": "25:39",
   "text": "[音楽]"
  },
  {
   "end_ms": "1555410",
   "start_ms": "1548539",
   "start_time_text": "25:48",
   "text": "本当に本当に本当に"
  },
  {
   "end_ms": "1555410",
   "start_ms": "1552250",
   "start_time_text": "25:52",
   "text": "[音楽]"
  },
  {
   "end_ms": "1558460",
   "start_ms": "1555980",
   "start_time_text": "25:55",
   "text": "申し訳ございません"
  },
  {
   "end_ms": "1576150",
   "start_ms": "1568890",
   "start_time_text": "26:08",
   "text": "[音楽]"
  },
  {
   "end_ms": "1579940",
   "start_ms": "1577520",
   "start_time_text": "26:17",
   "text": "ありがとうありがとう"
  },
  {
   "end_ms": "1605380",
   "start_ms": "1603200",
   "start_time_text": "26:43",
   "text": "申し訳ない"
  },
  {
   "end_ms": "1616580.0000000002",
   "start_ms": "1611200",
   "start_time_text": "26:51",
   "text": "名作誕生だよ"
  },
  {
   "end_ms": "1618159",
   "start_ms": "1614659",
   "start_time_text": "26:54",
   "text": "この後ロケ頑張ろうってそれこそやって"
  },
  {
   "end_ms": "1621080",
   "start_ms": "1616580",
   "start_time_text": "26:56",
   "text": "あげて"
  },
  {
   "end_ms": "1622240",
   "start_ms": "1618159",
   "start_time_text": "26:58",
   "text": "逆にもうね"
  },
  {
   "end_ms": "1625699.9999999998",
   "start_ms": "1621080",
   "start_time_text": "27:01",
   "text": "景気づけに"
  },
  {
   "end_ms": "1627640",
   "start_ms": "1622240",
   "start_time_text": "27:02",
   "text": "フルコースね"
  },
  {
   "end_ms": "1629860.0000000002",
   "start_ms": "1625700",
   "start_time_text": "27:05",
   "text": "差し上げようかなもうこれはもうやらで"
  },
  {
   "end_ms": "1632480",
   "start_ms": "1627640",
   "start_time_text": "27:07",
   "text": "行かせてください"
  },
  {
   "end_ms": "1633570",
   "start_ms": "1629860",
   "start_time_text": "27:09",
   "text": "今からやりますからね"
  },
  {
   "end_ms": "1639340",
   "start_ms": "1632480",
   "start_time_text": "27:12",
   "text": "頑張りましょう"
  },
  {
   "end_ms": "1645520",
   "start_ms": "1633570",
   "start_time_text": "27:13",
   "text": "[音楽]"
  },
  {
   "end_ms": "1645520",
   "start_ms": "1639340",
   "start_time_text": "27:19",
   "text": "[笑い]"
  },
