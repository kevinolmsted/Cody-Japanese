  {
   "end_ms": "1091760",
   "start_ms": "1085480",
   "start_time_text": "18:05",
   "text": "みんなアムイルって入ってんのチラン。"
  },
  {
   "end_ms": "1093520",
   "start_ms": "1089400",
   "start_time_text": "18:09",
   "text": "このアムイルベアが今回のポップアップの"
