  {
   "end_ms": "1014040.0000000001",
   "start_ms": "1008600",
   "start_time_text": "16:48",
   "text": "かもあると思うんですけど、基本店頭に"
  },
  {
   "end_ms": "1016720",
   "start_ms": "1011279",
   "start_time_text": "16:51",
   "text": "ずっと立ってるので、皆さんたくさん会い"
  },
  {
   "end_ms": "1019160",
   "start_ms": "1014040",
   "start_time_text": "16:54",
   "text": "来てくれたら嬉しいなと思いますけど、1"
  },
  {
   "end_ms": "1020920.0000000001",
   "start_ms": "1016720",
   "start_time_text": "16:56",
   "text": "日目で2日目もフリー入場にしたらもう"
