  {
   "end_ms": "932959",
   "start_ms": "928160",
   "start_time_text": "15:28",
   "text": "も多かった通りアムイル2回目の"
  },
  {
   "end_ms": "934639",
   "start_ms": "930440",
   "start_time_text": "15:30",
   "text": "ポップアップを開催することになりました"
  },
  {
   "end_ms": "940079",
   "start_ms": "932959",
   "start_time_text": "15:32",
