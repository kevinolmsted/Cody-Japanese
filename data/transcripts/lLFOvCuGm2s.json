   "end_ms": "1103320",
   "start_ms": "1099799",
   "start_time_text": "18:19",
   "text": "んですけど、このくまちゃんにもね、こう"
  },
  {
   "end_ms": "1105320",
   "start_ms": "1101520",
   "start_time_text": "18:21",
   "text": "意味合いがちょっとちゃんとありまして、"
  },
  {
   "end_ms": "1107678.9999999998",
   "start_ms": "1103320",
   "start_time_text": "18:23",
   "text": "なんか私はさ、韓国に住んでるじゃんけど"
  },
  {
   "end_ms": "1110639.9999999998",
   "start_ms": "1105320",
   "start_time_text": "18:25",
   "text": "、これを見てくれてるアムズのほとんどの"
  },
  {
   "end_ms": "1113000",
   "start_ms": "1107679",
   "start_time_text": "18:27",
   "text": "方が、ま、日本に住んでるって、よくさ、"
  },
  {
   "end_ms": "1114520.0000000002",
   "start_ms": "1110640",
   "start_time_text": "18:30",
   "text": "どこに住んでても頑張ることとか違ったり"
  },
  {
   "end_ms": "1117760",
   "start_ms": "1113000",
   "start_time_text": "18:33",
   "text": "しても、こう、一緒に頑張ろうっていう"
  },
  {
   "end_ms": "1119760",
   "start_ms": "1114520",
   "start_time_text": "18:34",
   "text": "気持ちとか、こう画面越しにはなるけど、"
  },
  {
   "end_ms": "1121600",
   "start_ms": "1117760",
   "start_time_text": "18:37",
   "text": "こう一緒に寄り添っで、こうなんか"
  },
  {
   "end_ms": "1123720",
   "start_ms": "1119760",
   "start_time_text": "18:39",
   "text": "頑張ろうねとかこう消していこうねみたい"
  },
  {
   "end_ms": "1125879.9999999998",
   "start_ms": "1121600",
   "start_time_text": "18:41",
   "text": "な感じのことをよく私言うじゃん。で、"
  },
  {
   "end_ms": "1128000",
   "start_ms": "1123720",
   "start_time_text": "18:43",
   "text": "それほんまに思っててなんかいつもね、"
  },
  {
   "end_ms": "1130760.0000000002",
   "start_ms": "1125880",
   "start_time_text": "18:45",
   "text": "こうみんなの心の近くで痛いなみたいな"
  },
  {
   "end_ms": "1132960",
   "start_ms": "1128000",
   "start_time_text": "18:48",
   "text": "思ってるからこうなんか寄り添えるものが"
  },
  {
   "end_ms": "1134879.9999999998",
   "start_ms": "1130760",
   "start_time_text": "18:50",
   "text": "あったらいいなと思ってこのくまちゃんに"
  },
  {
   "end_ms": "1137520",
   "start_ms": "1132960",
   "start_time_text": "18:52",
   "text": "ねどこかこうハートが入ってるんですよ。"
  },
  {
   "end_ms": "1140559.0000000002",
   "start_ms": "1134880",
   "start_time_text": "18:54",
   "text": "このくまちゃんほらここにハートが付い"
  },
  {
   "end_ms": "1144240",
   "start_ms": "1137520",
   "start_time_text": "18:57",
   "text": "てるのこの子は耳がハートになってるのね"
  },
  {
   "end_ms": "1146440",
   "start_ms": "1140559",
   "start_time_text": "19:00",
   "text": "。どっちの子はほら、こんな感じでね、"
  },
  {
