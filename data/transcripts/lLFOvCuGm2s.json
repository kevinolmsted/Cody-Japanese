  {
   "end_ms": "1039760",
   "start_ms": "1034720",
   "start_time_text": "17:14",
   "text": "販売開始するので時間とかはちょっとあの"
  },
  {
   "end_ms": "1041400.0000000001",
   "start_ms": "1037160.0000000001",
   "start_time_text": "17:17",
   "text": "インスタ公式のインスタとかを詳しく"
  },
  {
   "end_ms": "1043000",
   "start_ms": "1039760",
   "start_time_text": "17:19",
   "text": "チェックしてもらえたら嬉しいなと思い"
  },
  {
   "end_ms": "1045760",
   "start_ms": "1041400.0000000001",
   "start_time_text": "17:21",
   "text": "ます。私が韓国に住んで"
  },
  {
   "end_ms": "1047839",
   "start_ms": "1043000",
   "start_time_text": "17:23",
   "text": "るっていうのもあるし、次ね、東京でいつ"
  },
  {
   "end_ms": "1050080",
   "start_ms": "1045760",
   "start_time_text": "17:25",
   "text": "会えるかね、ほんまにちょっと結構未知と"
  },
  {
   "end_ms": "1052240",
   "start_ms": "1047839",
   "start_time_text": "17:27",
   "text": "いうか分からないので、会いに来てくれ"
  },
  {
   "end_ms": "1055678.9999999998",
   "start_ms": "1050080",
   "start_time_text": "17:30",
   "text": "たらとてもとても嬉しいなと思います。"
  },
  {
   "end_ms": "1057640",
   "start_ms": "1052240",
   "start_time_text": "17:32",
   "text": "もう本当に。はい、皆さん是非待ってます"
  },
  {
   "end_ms": "1060039",
   "start_ms": "1055679",
   "start_time_text": "17:35",
   "text": "。あの、オンライン発売とかも"
  },
  {
   "end_ms": "1062120.0000000002",
   "start_ms": "1057640",
   "start_time_text": "17:37",
   "text": "ポップアップなとすると思うので、よかっ"
  },
  {
   "end_ms": "1064480",
   "start_ms": "1060039",
   "start_time_text": "17:40",
   "text": "たらその辺も公式のインスタをチェックし"
