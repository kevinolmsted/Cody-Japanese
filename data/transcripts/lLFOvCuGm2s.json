   "end_ms": "832360",
   "start_ms": "828080",
   "start_time_text": "13:48",
   "text": "[音楽]"
  },
  {
   "end_ms": "833759",
   "start_ms": "829760",
   "start_time_text": "13:49",
   "text": "最悪な事件が起きました。"
  },
  {
   "end_ms": "836160",
   "start_ms": "832360",
   "start_time_text": "13:52",
   "text": "最悪な状態になってました。"
  },
  {
   "end_ms": "839160",
   "start_ms": "833759",
   "start_time_text": "13:53",
   "text": "SDカードないです。"
  },
  {
   "end_ms": "839160",
   "start_ms": "836160",
   "start_time_text": "13:56",
   "text": "このマーク無理。ただの棒です。"
  },
  {
   "end_ms": "843240",
   "start_ms": "840240",
   "start_time_text": "14:00",
   "text": "かなか"
  },
  {
   "end_ms": "849490",
   "start_ms": "844759",
   "start_time_text": "14:04",
   "text": "人生初一なんですけど生まれて初めてじん"
  },
  {
   "end_ms": "849490",
   "start_ms": "846290",
   "start_time_text": "14:06",
   "text": "[音楽]"
  },
  {
   "end_ms": "857800.0000000001",
   "start_ms": "852840",
   "start_time_text": "14:12",
   "text": "[音楽]"
  },
  {
   "end_ms": "860800",
   "start_ms": "855519",
   "start_time_text": "14:15",
   "text": "うん。"
  },
  {
   "end_ms": "860800",
   "start_ms": "857800",
   "start_time_text": "14:17",
   "text": "何これ?何の?ベールなんだけどベールよりさにる。"
  },
  {
   "end_ms": "868600",
   "start_ms": "865600",
   "start_time_text": "14:25",
   "text": "めっちゃしもしも大丈夫。"
  },
  {
   "end_ms": "872360",
   "start_ms": "869360",
   "start_time_text": "14:29",
   "text": "これぐらいだな。"
  },
  {
   "end_ms": "877800.0000000001",
   "start_ms": "873080",
   "start_time_text": "14:33",
   "text": "[音楽]"
  },
  {
   "end_ms": "877800",
   "start_ms": "874800",
   "start_time_text": "14:34",
   "text": "平和すぎ。金曜の夜にこれはそう。"
  },
  {
   "end_ms": "884920",
   "start_ms": "881079",
   "start_time_text": "14:41",
   "text": "どう?もう切れてる。"
  },
  {
   "end_ms": "887920",
   "start_ms": "884079",
   "start_time_text": "14:44",
   "text": "雰囲気ある。"
  },
  {
   "end_ms": "887920",
   "start_ms": "884920",
   "start_time_text": "14:44",
   "text": "エモい。みんな、みんなどう?これエモい。カサゴ越しに取るスタイル。どう?"
  },
  {
   "end_ms": "895160.0000000001",
   "start_ms": "890440",
   "start_time_text": "14:50",
   "text": "流行らしてこう。"
  },
  {
   "end_ms": "898250",
   "start_ms": "892639",
   "start_time_text": "14:52",
   "text": "絶対流行らくて無理。"
  },
  {
   "end_ms": "898250",
   "start_ms": "895160",
   "start_time_text": "14:55",
   "text": "[音楽]"
  },
  {
   "end_ms": "908440",
   "start_ms": "905440",
   "start_time_text": "15:05",
   "text": "東京です。初上陸です。東京。"
  },
  {
   "end_ms": "913359.9999999999",
   "start_ms": "908560",
   "start_time_text": "15:08",
   "text": "[音楽]"
  },
  {
   "end_ms": "916320",
   "start_ms": "909759",
   "start_time_text": "15:09",
   "text": "もう2025年最後にアムズに会いたいな"
  },
  {
   "end_ms": "919880",
   "start_ms": "913360",
   "start_time_text": "15:13",
   "text": "と思ってチケットとか関係なしにもう私"
  },
  {
   "end_ms": "922360",
   "start_ms": "916320",
   "start_time_text": "15:16",
   "text": "中グに12月7日いるのではい。そこで来"
  },
  {
   "end_ms": "925000",
   "start_ms": "919880",
   "start_time_text": "15:19",
   "text": "てくれたら会いますっていう感じです。皆"
  },
  {
   "end_ms": "928160",
   "start_ms": "922360",
   "start_time_text": "15:22",
   "text": "さんたくさん会い来てくれたら嬉しいなと"
  },
  {
   "end_ms": "930440",
   "start_ms": "925000",
   "start_time_text": "15:25",
   "text": "思います。じゃーラん。お気づきのアムズ"
