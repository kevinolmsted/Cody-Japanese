  {
   "end_ms": "1066678.9999999998",
   "start_ms": "1062120",
   "start_time_text": "17:42",
   "text": "てくれたら嬉しいです。で、今回の"
  },
  {
   "end_ms": "1068400",
   "start_ms": "1064480",
   "start_time_text": "17:44",
   "text": "ポップアップちょっとクリスマスみたいな"
  },
  {
   "end_ms": "1071000",
   "start_ms": "1066679",
   "start_time_text": "17:46",
   "text": "感じでいきたいんですけど、今回の"
  },
  {
   "end_ms": "1072600.0000000002",
   "start_ms": "1068400",
   "start_time_text": "17:48",
   "text": "ポップアップはい。ちょっと人しに"
  },
  {
   "end_ms": "1075600",
   "start_ms": "1071000",
   "start_time_text": "17:51",
   "text": "クリスマス当たりしもうっていう感じなん"
  },
  {
   "end_ms": "1078240",
   "start_ms": "1072600",
   "start_time_text": "17:52",
   "text": "やけど、じゃーラ"
  },
  {
   "end_ms": "1082360",
   "start_ms": "1075600",
   "start_time_text": "17:55",
   "text": "見てください。やばい。後ろ向いてるやん"
  },
  {
   "end_ms": "1085480",
   "start_ms": "1078240",
   "start_time_text": "17:58",
   "text": "。前向いて。チラン見てください。可愛"
  },
  {
   "end_ms": "1089399.9999999998",
   "start_ms": "1082360",
   "start_time_text": "18:02",
   "text": "すぎる。アムイルベアです。足元見て"
