  {
   "end_ms": "1096679",
   "start_ms": "1091760",
   "start_time_text": "18:11",
   "text": "ちょっと目玉企画みたいな感じなんです"
  },
  {
   "end_ms": "1099799",
   "start_ms": "1093520",
   "start_time_text": "18:13",
   "text": "けど、このアムイルオリジナルのくま"
  },
  {
   "end_ms": "1101520",
   "start_ms": "1096679",
   "start_time_text": "18:16",
   "text": "ちゃんのチャームアームルベアが誕生した"
  },
