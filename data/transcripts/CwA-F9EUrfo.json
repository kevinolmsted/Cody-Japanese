   "start_ms": "45960",
   "start_time_text": "0:45",
   "text": "もらったりとか車でちょっと連れ回したり"
  },
  {
   "end_ms": "53039",
   "start_ms": "48780",
   "start_time_text": "0:48",
   "text": "だとかそういういろんなことをしてまして"
