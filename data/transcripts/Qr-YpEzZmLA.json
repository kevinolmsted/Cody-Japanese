 "transcript": [
  {
   "end_ms": "25389.000000000004",
   "start_ms": "19437",
   "start_time_text": "0:19",
   "text": "昨夜は9時に寝ました"
  },
  {
   "end_ms": "33645",
   "start_ms": "29071",
   "start_time_text": "0:29",
   "text": "暑さに疲れて帰宅して"
  },
  {
   "end_ms": "41306.00000000001",
   "start_ms": "36761",
   "start_time_text": "0:36",
   "text": "シャワーをしたらすぐに寝ていました"
  },
  {
   "end_ms": "51009",
   "start_ms": "47153",
   "start_time_text": "0:47",
   "text": "いつも以上に空腹の朝です🤭"
  },
  {
   "end_ms": "57452.00000000001",
   "start_ms": "53566",
   "start_time_text": "0:53",
   "text": "残り少ないヨーグルトに アールグレイの茶葉を混ぜます"
  },
  {
   "end_ms": "72637",
   "start_ms": "68032",
   "start_time_text": "1:08",
   "text": "キッチンも静まり返っています。"
  },
  {
   "end_ms": "85660",
   "start_ms": "81175",
   "start_time_text": "1:21",
   "text": "こもった空気も入れ替えて、 新しい一日を始めよう"
  },
  {
   "end_ms": "146662",
   "start_ms": "142596",
   "start_time_text": "2:22",
   "text": "揚げ物料理をよくするせいで"
  },
  {
   "end_ms": "153114.99999999997",
   "start_ms": "148480",
   "start_time_text": "2:28",
   "text": "カバーに匂いや汚れがよく付きます"
  },
  {
   "end_ms": "163430",
   "start_ms": "157328",
   "start_time_text": "2:37",
   "text": "インテリアは失敗したなと思うことがよくあるのですが"
  },
  {
   "end_ms": "171949",
   "start_ms": "166835",
   "start_time_text": "2:46",
   "text": "カバーを丸洗いできるソファにしたのは正解でした😊"
  },
  {
   "end_ms": "188067",
   "start_ms": "182354",
   "start_time_text": "3:02",
   "text": "オキシクリーンと60℃のお湯に漬け置き"
  },
  {
   "end_ms": "234517",
   "start_ms": "230571",
   "start_time_text": "3:50",
   "text": "ももが熟れすぎてしまいました"
  },
  {
   "end_ms": "261851.99999999997",
   "start_ms": "257397",
   "start_time_text": "4:17",
   "text": "軽く水を切ったヨーグルト"
  },
  {
   "end_ms": "316553",
   "start_ms": "312098",
   "start_time_text": "5:12",
   "text": "水分たっぷりで、甘くて目が覚める朝食"
  },
  {
   "end_ms": "323375",
   "start_ms": "318141",
   "start_time_text": "5:18",
   "text": "紅茶の風味がついたヨーグルトがよく合います"
  },
  {
   "end_ms": "347299",
   "start_ms": "340868",
   "start_time_text": "5:40",
   "text": "買い物したいところが多くて AIに効率よく回れるルートを聞いてみました"
  },
  {
   "end_ms": "356984",
   "start_ms": "352409",
   "start_time_text": "5:52",
   "text": "架空のお店が出てきたので 頼りにするのをやめました😂"
  },
  {
   "end_ms": "369198.99999999994",
   "start_ms": "364085",
   "start_time_text": "6:04",
   "text": "お店が開くまで、 早めのランチを作ります。"
  },
  {
   "end_ms": "425317",
   "start_ms": "421311",
   "start_time_text": "7:01",
   "text": "乾燥容量オーバーなので 少し外に干します"
  },
  {
   "end_ms": "437329",
   "start_ms": "432754",
   "start_time_text": "7:12",
   "text": "今日はあっという間に乾きそうな天気です"
  },
  {
   "end_ms": "464465",
   "start_ms": "459351",
   "start_time_text": "7:39",
   "text": "生地を30分休ませながら ランチを作ります"
  },
  {
   "end_ms": "498017",
   "start_ms": "493532",
   "start_time_text": "8:13",
   "text": "牛乳・玉ねぎ・サーモン・バター"
  },
  {
   "end_ms": "519683",
   "start_ms": "515587",
   "start_time_text": "8:35",
   "text": "2つはソーセージのパン"
  },
  {
   "end_ms": "542400",
   "start_ms": "538424",
   "start_time_text": "8:58",
   "text": "ふたつはハートに"
  },
  {
   "end_ms": "565368.9999999999",
   "start_ms": "560165",
   "start_time_text": "9:20",
   "text": "玉ねぎ・サラダ油・酢・レモン汁・塩こしょう・からし"
  },
  {
   "end_ms": "574665.9999999999",
   "start_ms": "570121",
   "start_time_text": "9:30",
   "text": "ドレッシングを作り置きします"
  },
  {
   "end_ms": "584861",
   "start_ms": "582861",
   "start_time_text": "9:42",
   "text": "重曹"
  },
  {
   "end_ms": "614332",
   "start_ms": "612332",
   "start_time_text": "10:12",
   "text": "塩"
  },
  {
   "end_ms": "706539",
   "start_ms": "702473",
   "start_time_text": "11:42",
   "text": "サーモンのポタージュ 優しい色合いで温まります"
  },
  {
   "end_ms": "721495",
   "start_ms": "716231",
   "start_time_text": "11:56",
   "text": "プレッツェルのパン"
  },
  {
   "end_ms": "726990",
   "start_ms": "723732",
   "start_time_text": "12:03",
   "text": "程よいかたさで美味しいです"
  },
  {
   "end_ms": "735235",
   "start_ms": "730001",
   "start_time_text": "12:10",
   "text": "冷やすか迷ったけど、たまには温かいのもいいですね"
  },
  {
   "end_ms": "754406",
   "start_ms": "749322",
   "start_time_text": "12:29",
   "text": "生クリームが余っていたので アイスクリーム作り"
  },
  {
   "end_ms": "761089",
   "start_ms": "756514",
   "start_time_text": "12:36",
   "text": "抹茶・砂糖・卵・生クリーム"
  },
  {
   "end_ms": "792148",
   "start_ms": "787902",
   "start_time_text": "13:07",
   "text": "黒蜜を混ぜてみました"
  },
  {
   "end_ms": "800659",
   "start_ms": "796503",
   "start_time_text": "13:16",
   "text": "冷凍庫に仕込んで 出掛けます"
  },
  {
   "end_ms": "818878",
   "start_ms": "814542",
   "start_time_text": "13:34",
   "text": "キッチン用品が欲しくて cotogotoさんに来ました"
  },
  {
   "end_ms": "829716",
   "start_ms": "824872",
   "start_time_text": "13:44",
   "text": "最近、いつもと違うテイストの食器に惹かれます"
  },
  {
   "end_ms": "845332",
   "start_ms": "840667",
   "start_time_text": "14:00",
   "text": "お店に来ると 新しい発見がありますね"
  },
  {
   "end_ms": "853746",
   "start_ms": "849920",
   "start_time_text": "14:09",
   "text": "ずっと悩んでいる鍋です"
  },
  {
   "end_ms": "860523",
   "start_ms": "856816",
   "start_time_text": "14:16",
   "text": "こちらのフライパンは心に決めて来ました"
  },
  {
   "end_ms": "878265",
   "start_ms": "873391",
   "start_time_text": "14:33",
   "text": "まだお店を回りたいので 少し休憩です"
  },
  {
   "end_ms": "896251",
   "start_ms": "892395",
   "start_time_text": "14:52",
   "text": "8月の予定が少しずつ決まり始めました"
  },
  {
   "end_ms": "909477",
   "start_ms": "905321",
   "start_time_text": "15:05",
   "text": "セールもチェックしないと🤭"
  },
  {
   "end_ms": "930477",
   "start_ms": "926321",
   "start_time_text": "15:26",
   "text": "浴衣も受け取って、用事をすべて済ませました"
  },
  {
   "end_ms": "945094.9999999999",
   "start_ms": "938963",
   "start_time_text": "15:38",
   "text": "乾燥機よりベランダの方が早く乾きました"
  },
  {
   "end_ms": "963668",
   "start_ms": "958135",
   "start_time_text": "15:58",
   "text": "甘いもので休憩したかったので ちょうどよかったです🤭"
  },
  {
   "end_ms": "988339",
   "start_ms": "983794",
   "start_time_text": "16:23",
   "text": "ホワイトチョコレートもアイスに混ぜ込んでおきたかった・・・"
  },
  {
   "end_ms": "1004071",
   "start_ms": "999436",
   "start_time_text": "16:39",
   "text": "冷凍しておいた白玉団子もいい相性でした😋"
  },
  {
   "end_ms": "1023977",
   "start_ms": "1019192",
   "start_time_text": "16:59",
   "text": "浴衣ができあがりました"
  },
  {
   "end_ms": "1037703",
   "start_ms": "1033068",
   "start_time_text": "17:13",
   "text": "着物風にも着られるよう、襟を仕立ててもらいました"
  },
  {
   "end_ms": "1056490",
   "start_ms": "1049669",
   "start_time_text": "17:29",
   "text": "白地なので、透けにくいようにも仕立てていただき"
  },
  {
   "end_ms": "1069557",
   "start_ms": "1064593",
   "start_time_text": "17:44",
   "text": "自分だけの一着になったようで嬉しいです"
  },
  {
   "end_ms": "1082237",
   "start_ms": "1076884",
   "start_time_text": "17:56",
   "text": "シーツの匂いや黄ばみも綺麗になりました"
  },
  {
   "end_ms": "1099704.0000000002",
   "start_ms": "1095428",
   "start_time_text": "18:15",
   "text": "プチ気分転換に アームレストを外してみました"
  },
  {
   "end_ms": "1115312",
   "start_ms": "1111156",
   "start_time_text": "18:31",
   "text": "最後に買ってきたものも片付けます"
  },
  {
   "end_ms": "1130389",
   "start_ms": "1125964",
   "start_time_text": "18:45",
   "text": "友人が来た時に取り皿がなく困ったので セールでお皿を買いました"
  },
  {
   "end_ms": "1138487",
   "start_ms": "1133912",
