  },
  {
   "end_ms": "511020",
   "start_ms": "510240",
   "start_time_text": "8:30",
   "text": "（話を）聞いておらなんだ！"
  },
  {
   "end_ms": "511680",
   "start_ms": "511180",
   "start_time_text": "8:31",
   "text": "ほれ！"
  },
  {
   "end_ms": "515860",
   "start_ms": "514780",
   "start_time_text": "8:34",
   "text": "なんぞや？"
  },
  {
   "end_ms": "519360",
   "start_ms": "518280",
   "start_time_text": "8:38",
   "text": "寝床じゃよ"
  },
  {
   "end_ms": "521659.99999999994",
   "start_ms": "519520",
   "start_time_text": "8:39",
   "text": "寝床をもらえるとな"
  },
  {
   "end_ms": "525320",
   "start_ms": "523320.00000000006",
   "start_time_text": "8:43",
   "text": "お！"
  },
  {
   "end_ms": "526760.0000000001",
   "start_ms": "525320",
   "start_time_text": "8:45",
   "text": "巻物じゃよ"
  },
  {
   "end_ms": "528180",
   "start_ms": "526920",
   "start_time_text": "8:46",
   "text": "巻物じゃ！"
  },
  {
   "end_ms": "530187",
   "start_ms": "528580",
   "start_time_text": "8:48",
   "text": "巻かれておる"
  },
  {
   "end_ms": "532840",
   "start_ms": "530187",
   "start_time_text": "8:50",
   "text": "ついに始まりましたな"
