   "end_ms": "428260",
   "start_ms": "426960",
   "start_time_text": "7:06",
   "text": "なんぞ"
  },
  {
   "end_ms": "430780",
   "start_ms": "428260",
   "start_time_text": "7:08",
   "text": "まずは棟梁に挨拶せねばなるまいぞ"
