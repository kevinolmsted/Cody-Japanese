  {
   "end_ms": "382280",
   "start_ms": "380340",
   "start_time_text": "6:20",
   "text": "島流しにあらず"
  },
  {
   "end_ms": "384980",
   "start_ms": "382920",
   "start_time_text": "6:22",
   "text": "黄泉の国じゃよ"
  },
  {
   "end_ms": "386760",
   "start_ms": "385520",
   "start_time_text": "6:25",
   "text": "狸じゃ"
  },
  {
   "end_ms": "389000",
   "start_ms": "387020",
   "start_time_text": "6:27",
   "text": "楽しみになってきたのう"
