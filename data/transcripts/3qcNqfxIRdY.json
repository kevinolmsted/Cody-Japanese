 "transcript": [
  {
   "end_ms": "1500",
   "start_ms": "0",
   "start_time_text": "0:00",
   "text": "島流しか？"
  },
  {
   "end_ms": "2000",
   "start_ms": "1500",
   "start_time_text": "0:01",
   "text": "え？"
  },
  {
   "end_ms": "4600",
   "start_ms": "2000",
   "start_time_text": "0:02",
   "text": "島に住まわされるぞ"
  },
  {
   "end_ms": "6720",
   "start_ms": "4600",
   "start_time_text": "0:04",
   "text": "島流しにあうと申すか？"
  },
  {
   "end_ms": "7860",
   "start_ms": "6860",
   "start_time_text": "0:06",
   "text": "何を致したのじゃ？"
  },
  {
   "end_ms": "10440.000000000002",
   "start_ms": "7940",
   "start_time_text": "0:07",
   "text": "右大臣と左大臣を連れてきたと申すか？"
  },
  {
   "end_ms": "13719.999999999998",
   "start_ms": "10600",
   "start_time_text": "0:10",
   "text": "なれば某はここで幕府を開きまする！"
  },
  {
   "end_ms": "19660",
   "start_ms": "14540",
   "start_time_text": "0:14",
   "text": "（音楽） 集え！けもの共の藪！"
  },
  {
   "end_ms": "21300",
   "start_ms": "19660",
   "start_time_text": "0:19",
   "text": "よーっ！！ポン！ポン！（鼓の音）"
  },
  {
   "end_ms": "23140",
   "start_ms": "21300",
   "start_time_text": "0:21",
   "text": "いざ！参ろう"
  },
  {
   "end_ms": "23640",
   "start_ms": "23140",
   "start_time_text": "0:23",
   "text": "ポン！（鼓の音）"
  },
  {
   "end_ms": "25540",
   "start_ms": "23860",
   "start_time_text": "0:23",
   "text": "なんぞや"
  },
  {
   "end_ms": "26860",
   "start_ms": "25700",
   "start_time_text": "0:25",
   "text": "狸？"
  },
  {
   "end_ms": "27600",
   "start_ms": "27100",
   "start_time_text": "0:27",
   "text": "狸のなんぞや？"
  },
  {
   "end_ms": "30440",
   "start_ms": "29260",
   "start_time_text": "0:29",
   "text": "狸じゃ"
  },
  {
   "end_ms": "35900.00000000001",
   "start_ms": "32560.000000000004",
   "start_time_text": "0:32",
   "text": "二匹の狸が話しかけておりゃる。"
  },
  {
   "end_ms": "38880",
   "start_ms": "36680",
   "start_time_text": "0:36",
   "text": "化かしにきよったか？"
  },
  {
   "end_ms": "40860",
   "start_ms": "39140",
   "start_time_text": "0:39",
   "text": "人様を化かしに来よったのじゃよ"
  },
  {
   "end_ms": "45620.00000000001",
   "start_ms": "41420",
   "start_time_text": "0:41",
   "text": "まずは某の名前を決めればなるまいと申すか"
  },
  {
   "end_ms": "50780",
   "start_ms": "45620",
   "start_time_text": "0:45",
   "text": "易々とタヌキに名前教えては、また"
  },
  {
   "end_ms": "52480.00000000001",
   "start_ms": "50780",
   "start_time_text": "0:50",
   "text": "化かされて終いじゃ。"
  },
  {
   "end_ms": "53380",
   "start_ms": "52640",
   "start_time_text": "0:52",
   "text": "左様じゃな"
  },
  {
   "end_ms": "56800",
   "start_ms": "53660",
   "start_time_text": "0:53",
   "text": "某の名前を引き出そうとしてるやもしれぬ。"
  },
  {
   "end_ms": "58980",
   "start_ms": "56800",
   "start_time_text": "0:56",
   "text": "かような重要書類に名前をさっと書いては"
  },
  {
   "end_ms": "63620",
   "start_ms": "60640",
   "start_time_text": "1:00",
   "text": "詐欺に遭うだけよ 気をつけよ"
  },
  {
   "end_ms": "65620",
   "start_ms": "63620",
   "start_time_text": "1:03",
   "text": "三島で良いものか"
  },
  {
   "end_ms": "68660.00000000001",
   "start_ms": "65620",
   "start_time_text": "1:05",
   "text": "今後の事を考えれば三島じゃな（笑う）"
  },
  {
   "end_ms": "71940",
   "start_ms": "68820",
   "start_time_text": "1:08",
   "text": "名前くらいは教えてやろう"
  },
  {
   "end_ms": "73240",
   "start_ms": "71940",
   "start_time_text": "1:11",
   "text": "名前だけじゃぞ"
  },
  {
   "end_ms": "74080",
   "start_ms": "73240",
   "start_time_text": "1:13",
   "text": "狸め！"
  },
  {
   "end_ms": "77420",
   "start_ms": "74200",
   "start_time_text": "1:14",
   "text": "名前以外は一つも情報教えてはならぬぞ"
  },
  {
   "end_ms": "77920",
   "start_ms": "77420",
   "start_time_text": "1:17",
   "text": "えっ"
  },
  {
   "end_ms": "81060",
   "start_ms": "78800",
   "start_time_text": "1:18",
   "text": "みしまたつや？"
  },
  {
   "end_ms": "82059.99999999999",
   "start_ms": "81240",
   "start_time_text": "1:21",
   "text": "某の名前じゃよ"
  },
  {
   "end_ms": "85200",
   "start_ms": "82060",
   "start_time_text": "1:22",
   "text": "フルで。全部でいくのか？"
  },
  {
   "end_ms": "86880.00000000001",
   "start_ms": "85200",
   "start_time_text": "1:25",
   "text": "お主。"
  },
  {
   "end_ms": "92560",
   "start_ms": "86880",
   "start_time_text": "1:26",
   "text": "あ！なんと！某が生まれた日まで聞いてくるとな。"
  },
  {
   "end_ms": "94980",
   "start_ms": "92560",
   "start_time_text": "1:32",
   "text": "元旦の正月に参ろうぞ"
  },
  {
   "end_ms": "96690",
   "start_ms": "94980",
   "start_time_text": "1:34",
   "text": "元禄何年？"
  },
  {
   "end_ms": "99960",
   "start_ms": "96690",
   "start_time_text": "1:36",
   "text": "元禄八年元旦じゃよ！"
  },
  {
   "end_ms": "102160",
   "start_ms": "99960",
   "start_time_text": "1:39",
   "text": "嘘を申せ！"
  },
  {
   "end_ms": "104520",
   "start_ms": "102160",
   "start_time_text": "1:42",
   "text": "お主、元旦生まれ？"
  },
  {
   "end_ms": "105539.99999999999",
   "start_ms": "104520",
   "start_time_text": "1:44",
   "text": "めでたい男なのじゃ！"
  },
  {
   "end_ms": "106040",
   "start_ms": "105540",
   "start_time_text": "1:45",
   "text": "お主は10月とか中途半端な"
  },
  {
   "end_ms": "111680",
   "start_ms": "106909",
   "start_time_text": "1:46",
   "text": "中途半端な神無月の中途半端な生まれじゃ"
  },
  {
   "end_ms": "115440.00000000001",
   "start_ms": "111680",
   "start_time_text": "1:51",
   "text": "4日とかそれぐらいの？"
  },
  {
   "end_ms": "118140",
   "start_ms": "115440",
   "start_time_text": "1:55",
   "text": "聞いてくる狸じゃわい！"
  },
  {
   "end_ms": "120280",
   "start_ms": "118140",
   "start_time_text": "1:58",
   "text": "身だしなみを言っておるのう！"
  },
  {
   "end_ms": "120920",
   "start_ms": "120280",
   "start_time_text": "2:00",
   "text": "なんぞや？"
  },
  {
   "end_ms": "121420",
   "start_ms": "120920",
   "start_time_text": "2:00",
   "text": "身だしなみは、それで良いか？"
  },
  {
   "end_ms": "122700",
   "start_ms": "121420",
   "start_time_text": "2:01",
   "text": "お召し物のことも"
  },
  {
   "end_ms": "124800.00000000001",
   "start_ms": "122900",
   "start_time_text": "2:02",
   "text": "写し絵（写真）を撮ると申しておるぞ"
  },
  {
   "end_ms": "129940",
   "start_ms": "125020",
   "start_time_text": "2:05",
   "text": "え！そんなことがあるならば、もっと良い着物を用意してきたのに"
  },
  {
   "end_ms": "133380",
   "start_ms": "131120",
   "start_time_text": "2:11",
   "text": "一張羅で来たらよかったのう。"
  },
  {
   "end_ms": "136000",
   "start_ms": "133700",
   "start_time_text": "2:13",
   "text": "十二単で参れば良かったのう。"
  },
  {
   "end_ms": "138559.99999999997",
   "start_ms": "136140",
   "start_time_text": "2:16",
   "text": "十二単は女子の衣装よ。"
  },
  {
   "end_ms": "140020",
   "start_ms": "138560",
   "start_time_text": "2:18",
   "text": "某を決めれるとな"
  },
  {
   "end_ms": "141340",
   "start_ms": "140020",
   "start_time_text": "2:20",
   "text": "もうお主じゃよ。これ"
  },
  {
   "end_ms": "142700",
   "start_ms": "141480",
   "start_time_text": "2:21",
   "text": "否！否！否！"
  },
  {
   "end_ms": "144680",
   "start_ms": "142800",
   "start_time_text": "2:22",
   "text": "もっと貴族っぽくしたいのじゃよ"
  },
  {
   "end_ms": "146320",
   "start_ms": "144760",
   "start_time_text": "2:24",
   "text": "ほぼを主じゃな"
  },
  {
   "end_ms": "147900",
   "start_ms": "146440",
   "start_time_text": "2:26",
   "text": "口周り肌色じゃよ。"
  },
  {
   "end_ms": "149360",
   "start_ms": "147900",
   "start_time_text": "2:27",
   "text": "これだけしか選べぬと申すか"
  },
  {
   "end_ms": "151160",
   "start_ms": "149480",
   "start_time_text": "2:29",
   "text": "口周り肌色じゃったよ"
  },
  {
   "end_ms": "154100",
   "start_ms": "151560",
   "start_time_text": "2:31",
   "text": "大銀杏（力士の髪型）を結いたいじゃが"
  },
  {
   "end_ms": "155380",
   "start_ms": "154320",
   "start_time_text": "2:34",
   "text": "いや相撲力士！"
  },
  {
   "end_ms": "157220",
   "start_ms": "155500",
   "start_time_text": "2:35",
   "text": "大銀杏は結えぬのか？"
  },
  {
   "end_ms": "158280",
   "start_ms": "157400",
   "start_time_text": "2:37",
   "text": "お主、力士？"
  },
  {
   "end_ms": "161020",
   "start_ms": "158500",
   "start_time_text": "2:38",
   "text": "それくらいの髪型が良いのじゃが"
  },
  {
   "end_ms": "163740",
   "start_ms": "161020",
   "start_time_text": "2:41",
   "text": "おお！眼が選べるではないか"
  },
  {
   "end_ms": "164960",
   "start_ms": "163860",
   "start_time_text": "2:43",
   "text": "もっと（髪は）チリチリじゃがな"
  },
  {
   "end_ms": "166340",
   "start_ms": "165840",
   "start_time_text": "2:45",
   "text": "眼はもう。"
  },
  {
   "end_ms": "168020",
   "start_ms": "166580",
   "start_time_text": "2:46",
   "text": "それじゃな！（笑う）"
  },
  {
   "end_ms": "170720",
   "start_ms": "168220",
   "start_time_text": "2:48",
   "text": "それかのう"
  },
  {
   "end_ms": "174459.99999999997",
   "start_ms": "171140",
   "start_time_text": "2:51",
   "text": "違うのう。否！否！否！"
  },
  {
   "end_ms": "177800",
   "start_ms": "174460",
   "start_time_text": "2:54",
   "text": "某、独眼竜とかにしたいのう！"
  },
  {
   "end_ms": "180480",
   "start_ms": "177940",
   "start_time_text": "2:57",
   "text": "伊達政宗！"
  },
  {
   "end_ms": "182080",
   "start_ms": "180490",
   "start_time_text": "3:00",
   "text": "でも、その丸でも良いのう。"
  },
  {
   "end_ms": "185220",
   "start_ms": "182080",
   "start_time_text": "3:02",
   "text": "片目のやつはござらんか？"
  },
  {
   "end_ms": "186920.00000000003",
   "start_ms": "185300",
   "start_time_text": "3:05",
   "text": "片目はござらんか？"
  },
  {
   "end_ms": "187940",
   "start_ms": "186940",
   "start_time_text": "3:06",
   "text": "片目はないのじゃよ！"
  },
  {
   "end_ms": "189420.00000000003",
   "start_ms": "188680",
   "start_time_text": "3:08",
   "text": "これで参ろう"
  },
  {
   "end_ms": "192740",
   "start_ms": "191720",
   "start_time_text": "3:11",
   "text": "服も選びたいのう"
  },
  {
   "end_ms": "193640",
   "start_ms": "193140",
   "start_time_text": "3:13",
   "text": "着物が良いのじゃよ"
  },
  {
   "end_ms": "196640",
   "start_ms": "193640",
   "start_time_text": "3:13",
   "text": "まめきち（狸）が喜んでおるのう。"
  },
  {
   "end_ms": "197679.99999999997",
   "start_ms": "196640",
   "start_time_text": "3:16",
   "text": "ほれ、見よ！"
  },
  {
   "end_ms": "199400",
   "start_ms": "197680",
   "start_time_text": "3:17",
   "text": "喝采しておるぞ！"
  },
  {
   "end_ms": "200179.99999999997",
   "start_ms": "199420",
   "start_time_text": "3:19",
   "text": "いや騙されるな"
  },
  {
   "end_ms": "201740",
   "start_ms": "200180",
   "start_time_text": "3:20",
   "text": "狸の喝采じゃよ！"
  },
  {
   "end_ms": "206800",
   "start_ms": "201740",
   "start_time_text": "3:21",
   "text": "此奴、人様を喜ばせて今は油断させておるのよ。"
  },
  {
   "end_ms": "207579.99999999997",
   "start_ms": "206880",
   "start_time_text": "3:26",
   "text": "よいのう"
  },
  {
   "end_ms": "208760.00000000003",
   "start_ms": "207740",
   "start_time_text": "3:27",
   "text": "島！！"
  },
  {
   "end_ms": "210400",
   "start_ms": "208770",
   "start_time_text": "3:28",
   "text": "島流しか？"
  },
  {
   "end_ms": "211540",
   "start_ms": "210540",
   "start_time_text": "3:30",
   "text": "え？"
  },
  {
   "end_ms": "213679.99999999997",
   "start_ms": "211540",
   "start_time_text": "3:31",
   "text": "島に住まわせるぞ"
  },
  {
   "end_ms": "214879",
   "start_ms": "214100",
   "start_time_text": "3:34",
   "text": "え？"
  },
  {
   "end_ms": "216859.99999999997",
   "start_ms": "214880",
   "start_time_text": "3:34",
   "text": "島流しにあうと申すか？"
  },
  {
   "end_ms": "218060",
   "start_ms": "217020",
   "start_time_text": "3:37",
   "text": "何を致したのじゃ？"
  },
  {
   "end_ms": "220140.00000000003",
   "start_ms": "218680",
   "start_time_text": "3:38",
   "text": "何を致したのじゃ"
  },
  {
   "end_ms": "222720",
   "start_ms": "220540",
   "start_time_text": "3:40",
   "text": "わからん。嫌じゃ！嫌じゃ！"
  },
  {
   "end_ms": "225900",
   "start_ms": "222880",
   "start_time_text": "3:42",
   "text": "某らは、都に住みたいのじゃよ！"
  },
  {
   "end_ms": "232263",
   "start_ms": "229660",
   "start_time_text": "3:49",
   "text": "某のお住まいも聞かれておるのう"
  },
  {
   "end_ms": "236380",
   "start_ms": "235880",
   "start_time_text": "3:55",
   "text": "北半球？"
  },
  {
   "end_ms": "238460",
   "start_ms": "236400",
   "start_time_text": "3:56",
   "text": "（説明が）もう長いのう！"
  },
  {
   "end_ms": "241480",
   "start_ms": "238660",
   "start_time_text": "3:58",
   "text": "御意！皆、御意じゃ！"
  },
  {
   "end_ms": "243140",
   "start_ms": "241480",
   "start_time_text": "4:01",
   "text": "重要な局面で"
  },
  {
   "end_ms": "247660",
   "start_ms": "246340",
   "start_time_text": "4:06",
   "text": "早ういたせ！"
  },
  {
   "end_ms": "249400",
   "start_ms": "248660",
   "start_time_text": "4:08",
   "text": "無人島？"
  },
  {
   "end_ms": "250840",
   "start_ms": "249460",
   "start_time_text": "4:09",
   "text": "島流しの島を"
  },
  {
   "end_ms": "251960",
   "start_ms": "250960",
   "start_time_text": "4:10",
   "text": "某が決めると申すか？"
  },
  {
   "end_ms": "253300",
   "start_ms": "251960",
   "start_time_text": "4:11",
   "text": "左様！"
  },
  {
   "end_ms": "257000",
   "start_ms": "253300",
   "start_time_text": "4:13",
   "text": "島流しから先は決めれるのじゃ"
  },
  {
   "end_ms": "258260",
   "start_ms": "257000",
   "start_time_text": "4:17",
   "text": "罪を犯したのじゃよ"
  },
  {
   "end_ms": "264140",
   "start_ms": "260738.99999999997",
   "start_time_text": "4:20",
   "text": "どれが良いか全くわからんのう"
  },
  {
   "end_ms": "265554",
   "start_ms": "264140",
   "start_time_text": "4:24",
   "text": "みな同じじゃよ"
  },
  {
   "end_ms": "266489.99999999994",
   "start_ms": "265554",
   "start_time_text": "4:25",
   "text": "されども"
  },
  {
   "end_ms": "270000",
   "start_ms": "266490",
   "start_time_text": "4:26",
   "text": "川が多い方が良いのではござらんか"
  },
  {
   "end_ms": "272440",
   "start_ms": "270000",
   "start_time_text": "4:30",
   "text": "しっかり住もうとしておるな"
  },
  {
   "end_ms": "273360",
   "start_ms": "272440",
   "start_time_text": "4:32",
   "text": "これに致そうか"
  },
  {
   "end_ms": "276840",
   "start_ms": "274840",
   "start_time_text": "4:34",
   "text": "まあ、（どれも）一緒じゃろ"
  },
  {
   "end_ms": "277479.99999999994",
   "start_ms": "276840",
   "start_time_text": "4:36",
   "text": "違いがあるのか？"
  },
  {
   "end_ms": "278300",
   "start_ms": "277800",
   "start_time_text": "4:37",
   "text": "御意！"
  },
  {
   "end_ms": "279440",
   "start_ms": "278940",
   "start_time_text": "4:38",
   "text": "いや、OK!"
  },
  {
   "end_ms": "287070",
   "start_ms": "279440",
   "start_time_text": "4:39",
   "text": "もし無人島に1つだけ持って参るとしたらいずれや？"
  },
  {
   "end_ms": "289200",
   "start_ms": "287070",
   "start_time_text": "4:47",
   "text": "これを決めれるのじゃあな"
  },
  {
   "end_ms": "291120",
   "start_ms": "289200",
   "start_time_text": "4:49",
   "text": "持してくれるとな"
  },
  {
   "end_ms": "294540",
   "start_ms": "291120",
   "start_time_text": "4:51",
   "text": "灯り。寝袋。食糧。"
  },
  {
   "end_ms": "296280",
   "start_ms": "294880",
   "start_time_text": "4:54",
   "text": "無人島じゃからのう"
  },
  {
   "end_ms": "297900",
   "start_ms": "296400",
   "start_time_text": "4:56",
   "text": "まずは寝袋ではござらぬか？"
  },
  {
   "end_ms": "299159.99999999994",
   "start_ms": "297960",
   "start_time_text": "4:57",
   "text": "いや、食糧じゃろ！"
  },
  {
   "end_ms": "299900.00000000006",
   "start_ms": "299300",
   "start_time_text": "4:59",
   "text": "無人島じゃよ！"
  },
  {
   "end_ms": "301920",
   "start_ms": "300040",
   "start_time_text": "5:00",
   "text": "食量など調達すれば良いのよ"
  },
  {
   "end_ms": "303940",
   "start_ms": "302060",
   "start_time_text": "5:02",
   "text": "頼もしきお方！"
  },
  {
   "end_ms": "305740",
   "start_ms": "303940",
   "start_time_text": "5:03",
   "text": "ポン！（鼓の音）"
  },
  {
   "end_ms": "307940",
   "start_ms": "307440",
   "start_time_text": "5:07",
   "text": "なんぞや？"
  },
  {
   "end_ms": "312180",
   "start_ms": "309640",
   "start_time_text": "5:09",
   "text": "やはり島流しではござらぬか？"
  },
  {
   "end_ms": "313599.99999999994",
   "start_ms": "312820",
   "start_time_text": "5:12",
   "text": "島流しじゃよ！"
  },
  {
   "end_ms": "318620",
   "start_ms": "317120",
   "start_time_text": "5:17",
   "text": "共に行くのか？狸と？"
  },
  {
   "end_ms": "320820",
   "start_ms": "318620",
   "start_time_text": "5:18",
   "text": "お待ちくだされ！"
  },
  {
   "end_ms": "322278",
   "start_ms": "320820",
   "start_time_text": "5:20",
   "text": "やはり（狸に）化かされ、"
  },
  {
   "end_ms": "323719.99999999994",
   "start_ms": "322280",
   "start_time_text": "5:22",
   "text": "騙されてるような気が致すのう"
  },
  {
   "end_ms": "326299.99999999994",
   "start_ms": "323960",
   "start_time_text": "5:23",
   "text": "これは嫌な予感が致すなぁ"
  },
  {
   "end_ms": "328960.00000000006",
   "start_ms": "326480",
   "start_time_text": "5:26",
   "text": "ああ！流されてしもうた！"
  },
  {
   "end_ms": "331060",
   "start_ms": "330560",
   "start_time_text": "5:30",
   "text": "これは！"
  },
  {
   "end_ms": "333840",
   "start_ms": "333340",
   "start_time_text": "5:33",
   "text": "ほのぼのとした"
  },
  {
   "end_ms": "334860",
   "start_ms": "334360",
   "start_time_text": "5:34",
   "text": "日に焼けて"
  },
  {
   "end_ms": "336280",
   "start_ms": "335780",
   "start_time_text": "5:35",
   "text": "なんぞや"
  },
  {
   "end_ms": "339660",
   "start_ms": "337720",
   "start_time_text": "5:37",
   "text": "（鼓を打つ南條）"
  },
  {
   "end_ms": "344440",
   "start_ms": "341100",
   "start_time_text": "5:41",
   "text": "セミじゃよ。てふてふ（蝶）も飛んでおる！"
  },
  {
   "end_ms": "346880",
   "start_ms": "345700",
   "start_time_text": "5:45",
   "text": "庭園のようじゃ"
  },
  {
   "end_ms": "347380",
   "start_ms": "346880",
   "start_time_text": "5:46",
   "text": "川が流れておる"
  },
  {
   "end_ms": "350940",
   "start_ms": "348840",
   "start_time_text": "5:48",
   "text": "紅葉しておるのう"
  },
  {
   "end_ms": "353200",
   "start_ms": "351200",
   "start_time_text": "5:51",
   "text": "四季があるとな"
  },
  {
   "end_ms": "354420",
   "start_ms": "353440",
   "start_time_text": "5:53",
   "text": "これは！"
  },
  {
   "end_ms": "357040",
   "start_ms": "354600",
   "start_time_text": "5:54",
   "text": "島流しと思うておったが"
  },
  {
   "end_ms": "359040",
   "start_ms": "357220",
   "start_time_text": "5:57",
   "text": "この世の楽園じゃ"
  },
  {
   "end_ms": "361220",
   "start_ms": "359220",
   "start_time_text": "5:59",
   "text": "極楽浄土に来たのやもしれんぞ"
  },
  {
   "end_ms": "362380.00000000006",
   "start_ms": "361220",
   "start_time_text": "6:01",
   "text": "楽しげ！"
  },
  {
   "end_ms": "363080",
   "start_ms": "362580",
   "start_time_text": "6:02",
   "text": "愉快！愉快！"
  },
  {
   "end_ms": "364140",
   "start_ms": "363640",
   "start_time_text": "6:03",
   "text": "けもの共の一族！"
  },
  {
   "end_ms": "367919.99999999994",
   "start_ms": "364140",
   "start_time_text": "6:04",
   "text": "けもの共の一族！"
  },
  {
   "end_ms": "370600",
   "start_ms": "368220",
   "start_time_text": "6:08",
   "text": "これは楽しげな絵じゃ！"
  },
  {
   "end_ms": "373680",
   "start_ms": "371820",
   "start_time_text": "6:11",
   "text": "これは楽しみじゃ！"
  },
  {
   "end_ms": "376099.99999999994",
   "start_ms": "373820",
   "start_time_text": "6:13",
   "text": "かような暮らしを求めて"
  },
  {
   "end_ms": "378340",
   "start_ms": "376340",
   "start_time_text": "6:16",
   "text": "我らは島に移り住むとな"
  },
  {
   "end_ms": "380340",
   "start_ms": "378340",
   "start_time_text": "6:18",
   "text": "聞いておった島流しと違うのう"
