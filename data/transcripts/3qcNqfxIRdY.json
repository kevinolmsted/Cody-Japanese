   "end_ms": "486800",
   "start_ms": "484820",
   "start_time_text": "8:04",
   "text": "化かし合いならこちらも"
  },
  {
   "end_ms": "488240",
   "start_ms": "486800",
   "start_time_text": "8:06",
   "text": "乗ってやるわい！"
  },
  {
   "end_ms": "490299.99999999994",
   "start_ms": "488520",
   "start_time_text": "8:08",
   "text": "「たぬきち」よ"
  },
