   "end_ms": "492960.00000000006",
   "start_ms": "490300",
   "start_time_text": "8:10",
   "text": "たぬきちと申すか"
  },
  {
   "end_ms": "495060",
   "start_ms": "493060",
   "start_time_text": "8:13",
   "text": "某は三島と申す"
