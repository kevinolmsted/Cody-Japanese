 "transcript": [
  {
   "end_ms": "2517.0000000000005",
   "start_ms": "1100",
   "start_time_text": "0:01",
   "text": "今日やっていくのは"
  },
  {
   "end_ms": "5449.999999999999",
   "start_ms": "2517",
   "start_time_text": "0:02",
   "text": "可愛い生き物が 施設内を走り回るゲーム"
  },
  {
   "end_ms": "7067",
   "start_ms": "5450",
   "start_time_text": "0:05",
   "text": "『CARRION』"
  },
  {
   "end_ms": "12183",
   "start_ms": "7067",
   "start_time_text": "0:07",
   "text": "今回は研究施設に閉じ込められた 可哀想な生き物が主人公"
  },
  {
   "end_ms": "17500",
   "start_ms": "12183",
   "start_time_text": "0:12",
   "text": "施設からの脱出を目指しながら 愚かな人間どもを楽しくしばいていきましょう"
  },
  {
   "end_ms": "18850",
   "start_ms": "17500",
   "start_time_text": "0:17",
   "text": "ニューゲーム"
  },
  {
   "end_ms": "31533",
   "start_ms": "28350",
   "start_time_text": "0:28",
   "text": "という訳で 早速はじまりました"
  },
  {
   "end_ms": "33517",
   "start_ms": "31533",
   "start_time_text": "0:31",
   "text": "今回の主人公となるのは"
  },
  {
   "end_ms": "36767",
   "start_ms": "33517",
   "start_time_text": "0:33",
   "text": "このウニョウニョとした 不思議な生き物です"
  },
  {
   "end_ms": "40000",
   "start_ms": "36767",
   "start_time_text": "0:36",
   "text": "吸い込んだ相手の力を 自分のものにできるらしいから"
  },
  {
   "end_ms": "44483",
   "start_ms": "40000",
   "start_time_text": "0:40",
   "text": "さしずめ 海外版『星のカービィ』といったところでしょうか"
  },
  {
   "end_ms": "49183",
   "start_ms": "44483",
   "start_time_text": "0:44",
   "text": "さて 当面の目的はこの研究施設からの脱出ということで"
  },
  {
   "end_ms": "53317",
   "start_ms": "49183",
   "start_time_text": "0:49",
   "text": "まずはダクトを通りながら 隣の区画へと移動"
  },
  {
   "end_ms": "57617",
   "start_ms": "53317",
   "start_time_text": "0:53",
   "text": "触手で扉を破壊しつつ 前へ前へと進んでいきます"
  },
  {
   "end_ms": "60967",
   "start_ms": "57617",
   "start_time_text": "0:57",
   "text": "おや、こんなところに人間を発見"
  },
  {
   "end_ms": "65283",
   "start_ms": "60967",
   "start_time_text": "1:00",
   "text": "すべての食材に感謝を込めて── いただきます"
  },
  {
   "end_ms": "67183",
   "start_ms": "65283",
   "start_time_text": "1:05",
   "text": "GOCHISOUSAMA"
  },
  {
   "end_ms": "72567",
   "start_ms": "68550",
   "start_time_text": "1:08",
   "text": "しばらく進んでいくと 軍事廃棄場とやらに到着"
  },
  {
   "end_ms": "76317",
   "start_ms": "72567",
   "start_time_text": "1:12",
   "text": "触手でレバーを操作して 扉のロックを解除"
  },
  {
   "end_ms": "79449.99999999999",
   "start_ms": "76317",
   "start_time_text": "1:16",
   "text": "銃を構えた凶暴な人間が徘徊していたので"
  },
  {
   "end_ms": "83183",
   "start_ms": "79450",
   "start_time_text": "1:19",
   "text": "扉ごと吹き飛ばして 上手く退治していきます"
  },
  {
   "end_ms": "86267",
   "start_ms": "84667",
   "start_time_text": "1:24",
   "text": "GOCHISOUSAMA"
  },
  {
   "end_ms": "88449.99999999999",
   "start_ms": "86267",
   "start_time_text": "1:26",
   "text": "ふぅ 怖かった"
  },
  {
   "end_ms": "94100",
   "start_ms": "90067",
   "start_time_text": "1:30",
   "text": "探索を進めていると 何やら良さそうなコンテナを発見"
  },
  {
   "end_ms": "96633",
   "start_ms": "94100",
   "start_time_text": "1:34",
   "text": "早速 吸い込んでみます"
  },
  {
   "end_ms": "101850",
   "start_ms": "98783",
   "start_time_text": "1:38",
   "text": "これで新しいDNAを吸収"
  },
  {
   "end_ms": "105517",
   "start_ms": "101850",
   "start_time_text": "1:41",
   "text": "クモの巣を発射して モノを動かしたりできるそうです"
  },
  {
   "end_ms": "109167",
   "start_ms": "107950",
   "start_time_text": "1:47",
   "text": "おおー"
  },
  {
   "end_ms": "113450",
   "start_ms": "110417",
   "start_time_text": "1:50",
   "text": "これで 新たに探索範囲が拡大"
  },
  {
   "end_ms": "117717",
   "start_ms": "113450",
   "start_time_text": "1:53",
   "text": "この調子で進化して 最強の生物を目指していきましょう"
  },
  {
   "end_ms": "121417",
   "start_ms": "120383",
   "start_time_text": "2:00",
   "text": "おっ"
  },
  {
   "end_ms": "124817",
   "start_ms": "121417",
   "start_time_text": "2:01",
   "text": "装備を着込んだ 強そうな人間を発見"
  },
  {
   "end_ms": "127883",
   "start_ms": "124817",
   "start_time_text": "2:04",
   "text": "まずは 鳴き声で扉付近におびき寄せてから"
  },
  {
   "end_ms": "130433",
   "start_ms": "127883",
   "start_time_text": "2:07",
   "text": "レバーを下げて 扉を開放"
  },
  {
   "end_ms": "134483",
   "start_ms": "130433",
   "start_time_text": "2:10",
   "text": "その辺のゴミを投げつけて まとめて無力化していきます"
  },
  {
   "end_ms": "136483",
   "start_ms": "134483",
   "start_time_text": "2:14",
   "text": "これは食べられないみたいなので"
  },
  {
   "end_ms": "139983",
   "start_ms": "136483",
   "start_time_text": "2:16",
   "text": "適当に潰して その辺に捨てておきましょう"
  },
  {
   "end_ms": "144167",
   "start_ms": "139983",
   "start_time_text": "2:19",
   "text": "扉を開けた先では 新たなDNAのコンテナを発見"
  },
  {
   "end_ms": "146483",
   "start_ms": "144167",
   "start_time_text": "2:24",
   "text": "早速吸い込んでみます"
  },
  {
   "end_ms": "153417",
   "start_ms": "149083",
   "start_time_text": "2:29",
   "text": "新しい能力を獲得し 心なしか体も巨大化"
  },
  {
   "end_ms": "157083",
   "start_ms": "153417",
   "start_time_text": "2:33",
   "text": "突進で 壁を破壊できるようになったみたいです"
  },
  {
   "end_ms": "161483",
   "start_ms": "157083",
   "start_time_text": "2:37",
   "text": "この能力のおかげで 食材のカットも更に快適に"
  },
  {
   "end_ms": "165567",
   "start_ms": "161483",
   "start_time_text": "2:41",
   "text": "面倒な銃持ちの個体も 壁ごと切り刻めばこの通り"
  },
  {
   "end_ms": "168583",
   "start_ms": "165567",
   "start_time_text": "2:45",
   "text": "安全に調理していけてうま味です"
  },
  {
   "end_ms": "174216.99999999997",
   "start_ms": "170100",
   "start_time_text": "2:50",
   "text": "突進で探索を進めていると 植物園へと到着"
  },
  {
   "end_ms": "177850.00000000003",
   "start_ms": "174217",
   "start_time_text": "2:54",
   "text": "意味ありげなレーザーセンサーの先にコンテナも発見"
  },
  {
   "end_ms": "181733",
   "start_ms": "177850",
   "start_time_text": "2:57",
   "text": "ここでも新たなDNAを吸収していきます"
  },
  {
   "end_ms": "186566.99999999997",
   "start_ms": "182950",
   "start_time_text": "3:02",
   "text": "エネルギーを消費して体を透明化する能力とのことで"
  },
  {
   "end_ms": "190133",
   "start_ms": "186567",
   "start_time_text": "3:06",
   "text": "ひとまず配電盤からエネルギーを補給"
  },
  {
   "end_ms": "192717",
   "start_ms": "190133",
   "start_time_text": "3:10",
   "text": "触れると扉が閉じてしまうセンサーも"
  },
  {
   "end_ms": "195350.00000000003",
   "start_ms": "192717",
   "start_time_text": "3:12",
   "text": "透明化ですり抜ければこの通り"
  },
  {
   "end_ms": "198600",
   "start_ms": "195350",
   "start_time_text": "3:15",
   "text": "視覚に頼りがちな人間にも有効だと思うので"
  },
  {
   "end_ms": "202132.99999999997",
   "start_ms": "198600",
   "start_time_text": "3:18",
   "text": "今後の食事面でも 重宝しそうな能力やね"
  },
  {
   "end_ms": "208416.99999999997",
   "start_ms": "204283",
   "start_time_text": "3:24",
   "text": "さて 今度は水中での探索能力を進化させるべく"
  },
  {
   "end_ms": "211317",
   "start_ms": "208417",
   "start_time_text": "3:28",
   "text": "『リヴァイアサン環礁基地』とやらを訪問"
  },
  {
   "end_ms": "215033.00000000003",
   "start_ms": "211317",
   "start_time_text": "3:31",
   "text": "今回吸収していくDNAは──"
  },
  {
   "end_ms": "218232.99999999997",
   "start_ms": "215033",
   "start_time_text": "3:35",
   "text": "水中でミミズの群れに変身する能力"
  },
  {
   "end_ms": "221583",
   "start_ms": "218233",
   "start_time_text": "3:38",
   "text": "これで 今まで通れなかった通路もこの通り"
  },
  {
   "end_ms": "225417",
   "start_ms": "221583",
   "start_time_text": "3:41",
   "text": "この瞬間が この手のゲームの醍醐味のひとつよね"
  },
  {
   "end_ms": "232100.00000000003",
   "start_ms": "227967",
   "start_time_text": "3:47",
   "text": "基地内では いかつそうな警備兵も巡回している模様"
  },
  {
   "end_ms": "235867",
   "start_ms": "232100",
   "start_time_text": "3:52",
   "text": "警戒されてしまう前に 背後からこっそりと這い寄って"
  },
  {
   "end_ms": "238500",
   "start_ms": "235867",
   "start_time_text": "3:55",
   "text": "一気に中身をいただいちゃいましょう"
  },
  {
   "end_ms": "245117",
   "start_ms": "243517",
   "start_time_text": "4:03",
   "text": "GOCHISOUSAMA"
  },
  {
   "end_ms": "247649.99999999997",
   "start_ms": "245117",
   "start_time_text": "4:05",
   "text": "意外と呆気ない幕引きでした"
  },
  {
   "end_ms": "254533",
   "start_ms": "250617",
   "start_time_text": "4:10",
   "text": "その後も 基地内をくまなく探索していく主人公"
  },
  {
   "end_ms": "258166.99999999997",
   "start_ms": "254533",
   "start_time_text": "4:14",
   "text": "今回見つけた こちらのコンテナからは──"
  },
  {
   "end_ms": "263267",
   "start_ms": "259767",
   "start_time_text": "4:19",
   "text": "他の生物を操れる 寄生能力を獲得"
  },
  {
   "end_ms": "267300",
   "start_ms": "263267",
   "start_time_text": "4:23",
   "text": "手始めに この生物の身体をいただいてみましょう"
  },
  {
   "end_ms": "271267",
   "start_ms": "267300",
   "start_time_text": "4:27",
   "text": "まずは ゆっくりと起き上がってレバーを操作"
  },
  {
   "end_ms": "274867",
   "start_ms": "271267",
   "start_time_text": "4:31",
   "text": "そのまま扉の先に向かってみます"
  },
  {
   "end_ms": "278117",
   "start_ms": "274867",
   "start_time_text": "4:34",
   "text": "用済みになった頃合いで 寄生を解除"
  },
  {
   "end_ms": "282033",
   "start_ms": "278117",
   "start_time_text": "4:38",
   "text": "お腹から登場して 宿主を怖がらせていきましょう"
  },
  {
   "end_ms": "288050",
   "start_ms": "283600",
   "start_time_text": "4:43",
   "text": "寄生能力のおかげで その後の探索もより快適に変化"
  },
  {
   "end_ms": "291683",
   "start_ms": "288050",
   "start_time_text": "4:48",
   "text": "食べられもせず 捨てておくだけだった戦闘服の人達も"
  },
  {
   "end_ms": "296217",
   "start_ms": "291683",
   "start_time_text": "4:51",
   "text": "この能力の入手後は 何かと重宝する機会が増えました"
  },
  {
   "end_ms": "299733",
   "start_ms": "296217",
   "start_time_text": "4:56",
   "text": "ここではレバーを操作して 扉を開放"
  },
  {
   "end_ms": "303200",
   "start_ms": "299817",
   "start_time_text": "4:59",
   "text": "解除前に こいつも掃除しておきましょう"
  },
  {
   "end_ms": "307033",
   "start_ms": "305700",
   "start_time_text": "5:05",
   "text": "OK"
  },
  {
   "end_ms": "309267",
   "start_ms": "307033",
   "start_time_text": "5:07",
   "text": "同僚 撃破です"
  },
  {
   "end_ms": "317183",
   "start_ms": "313133",
   "start_time_text": "5:13",
   "text": "探索を進めていると またしてもコンテナを発見"
  },
  {
   "end_ms": "319517",
   "start_ms": "317183",
   "start_time_text": "5:17",
   "text": "今回獲得していく能力は──"
  },
  {
   "end_ms": "323483",
   "start_ms": "319517",
   "start_time_text": "5:19",
   "text": "エネルギーを消費して 全身にトゲを生やす能力"
  },
  {
   "end_ms": "328183",
   "start_ms": "323483",
   "start_time_text": "5:23",
   "text": "ギミック用途ではなく 対人間用の戦闘能力みたいやね"
  },
  {
   "end_ms": "330900",
   "start_ms": "328183",
   "start_time_text": "5:28",
   "text": "おあつらえむきに 人間が集まっていたので"
  },
  {
   "end_ms": "333816.99999999994",
   "start_ms": "330900",
   "start_time_text": "5:30",
   "text": "トゲで撫でて 寝かしつけておきましょう"
  },
  {
   "end_ms": "339567",
   "start_ms": "335883",
   "start_time_text": "5:35",
   "text": "この生物は 一体どこからやってきたのか"
  },
  {
   "end_ms": "343733",
   "start_ms": "339567",
   "start_time_text": "5:39",
   "text": "その片鱗が この装置に潜り込んでみると窺えます"
  },
  {
   "end_ms": "347083",
   "start_ms": "343733",
   "start_time_text": "5:43",
   "text": "これは過去の記憶を再生できる装置のようで"
  },
  {
   "end_ms": "351367",
   "start_ms": "347083",
   "start_time_text": "5:47",
   "text": "要するに この生物の回想シーンを閲覧できるみたい"
  },
  {
   "end_ms": "369183",
   "start_ms": "363700",
   "start_time_text": "6:03",
   "text": "この回想は 気絶していた調査員が ゆっくりと起き上がるところからスタート"
  },
  {
   "end_ms": "373082.99999999994",
   "start_ms": "369183",
   "start_time_text": "6:09",
   "text": "化け物の住処に サンプル採集にやってきた調査員でしたが"
  },
  {
   "end_ms": "377250",
   "start_ms": "373083",
   "start_time_text": "6:13",
   "text": "気付けば気絶しており 調査対象の化け物は不在"
  },
  {
   "end_ms": "381667",
   "start_ms": "377267",
   "start_time_text": "6:17",
   "text": "一旦外に出て 調査チーム達のところに合流します"
  },
  {
   "end_ms": "390883",
   "start_ms": "387467",
   "start_time_text": "6:27",
   "text": "恐らく これが調査チームの仲間達"
  },
  {
   "end_ms": "393832.99999999994",
   "start_ms": "390883",
   "start_time_text": "6:30",
   "text": "ひとまず合流できて 安心しました"
  },
  {
   "end_ms": "407417",
   "start_ms": "405500",
   "start_time_text": "6:45",
   "text": "ぐええええええ"
  },
  {
   "end_ms": "413533",
   "start_ms": "410267",
   "start_time_text": "6:50",
   "text": "という訳で 調査員は既に寄生されており"
  },
  {
   "end_ms": "416933",
   "start_ms": "413533",
   "start_time_text": "6:53",
   "text": "撮影で擬態がバレて 化け物は拘束"
  },
  {
   "end_ms": "419933",
   "start_ms": "416933",
   "start_time_text": "6:56",
   "text": "バラバラにされ コンテナへと収容された後は"
  },
  {
   "end_ms": "423483",
   "start_ms": "419933",
   "start_time_text": "6:59",
   "text": "研究材料として 閉じ込められていたようです"
  },
  {
   "end_ms": "429083",
   "start_ms": "425300",
   "start_time_text": "7:05",
   "text": "その後も探索を進めていくと 新たなコンテナを発見"
  },
  {
   "end_ms": "431550",
   "start_ms": "429083",
   "start_time_text": "7:09",
   "text": "今回吸収していく能力は──"
  },
  {
   "end_ms": "434867",
   "start_ms": "431550",
   "start_time_text": "7:11",
   "text": "筋肉を銛のように発射する能力"
  },
  {
   "end_ms": "438600",
   "start_ms": "434867",
   "start_time_text": "7:14",
   "text": "人間を串刺しにできるだけでなく 栓抜きにも使えるようで"
  },
  {
