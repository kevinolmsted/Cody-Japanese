   "end_ms": "1884404",
   "start_ms": "1876218",
   "start_time_text": "31:16",
   "text": "今年もまた冬がやって来ますね🧥"
  },
  {
   "end_ms": "1905014",
   "start_ms": "1898359",
   "start_time_text": "31:38",
   "text": "必ず完了しないといけない予定がある休日の朝"
  },
