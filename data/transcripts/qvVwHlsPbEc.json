 "is_auto_generated": false,
 "language": "Japanese",
 "language_code": "ja",
 "transcript": [
  {
   "end_ms": "20000",
   "start_ms": "14625",
   "start_time_text": "0:14",
   "text": "時計の電池が切れていた朝"
  },
  {
   "end_ms": "30000",
   "start_ms": "23734",
   "start_time_text": "0:23",
   "text": "エアコンをつけずに眠れる夜が増えてきました"
  },
  {
   "end_ms": "40000",
   "start_ms": "32729",
   "start_time_text": "0:32",
   "text": "今度やろうと溜め込んでいるカゴです"
  },
  {
   "end_ms": "51219",
   "start_ms": "43862",
   "start_time_text": "0:43",
   "text": "週末は予定がいくつかあるので 少しだけ早起きして片付けることにしました"
  },
  {
   "end_ms": "65450",
   "start_ms": "58763",
   "start_time_text": "0:58",
   "text": "乾燥機に入れるとシワシワになる生地"
  },
  {
   "end_ms": "74826.00000000001",
   "start_ms": "68394",
   "start_time_text": "1:08",
   "text": "家の中で使うものだし シワシワでもいいかなと思ったりもするのですが"
  },
  {
   "end_ms": "87689",
   "start_ms": "79472",
   "start_time_text": "1:19",
   "text": "アイロンがけから始まる一日も気持ちいいです✨"
  },
  {
   "end_ms": "104137",
   "start_ms": "99267",
   "start_time_text": "1:39",
   "text": "スーッと伸びていく生地"
  },
  {
   "end_ms": "111456",
   "start_ms": "106842",
   "start_time_text": "1:46",
   "text": "暑さも和らいでアイロンも苦ではありません"
  },
  {
   "end_ms": "136831",
   "start_ms": "128642",
   "start_time_text": "2:08",
   "text": "夏のお出かけによく被った帽子 メイク汚れが付いてしまいました"
  },
  {
   "end_ms": "145651",
   "start_ms": "139315",
   "start_time_text": "2:19",
   "text": "洗剤をつけるつもりでしたが お湯だけで落とせました"
  },
  {
   "end_ms": "156041.99999999997",
   "start_ms": "152384",
   "start_time_text": "2:32",
   "text": "形を崩さないように・・・"
  },
  {
   "end_ms": "175740",
   "start_ms": "171668",
   "start_time_text": "2:51",
   "text": "気になっていた汚れ"
  },
  {
   "end_ms": "183345",
   "start_ms": "179177",
   "start_time_text": "2:59",
   "text": "さっと拭いたり水洗いでも落とせるのに"
  },
  {
   "end_ms": "190536.99999999997",
   "start_ms": "185986",
   "start_time_text": "3:05",
   "text": "なんでかいつも見てみぬふりをしてしまいます"
  },
  {
   "end_ms": "202602.99999999997",
   "start_ms": "196968",
   "start_time_text": "3:16",
   "text": "やり始めるまでが一番時間がかかるんですよね🤭"
  },
  {
   "end_ms": "225656.99999999997",
   "start_ms": "220118",
   "start_time_text": "3:40",
   "text": "30分の早起きの成果"
  },
  {
   "end_ms": "232743.00000000003",
   "start_ms": "227300",
   "start_time_text": "3:47",
   "text": "朝一番の達成感で気分も爽やかです"
  },
  {
   "end_ms": "260000",
   "start_ms": "255166",
   "start_time_text": "4:15",
   "text": "本当は昨夜、寝る前ににやりたかったのですが"
  },
  {
   "end_ms": "266875",
   "start_ms": "262197",
   "start_time_text": "4:22",
   "text": "鶏肉を味噌漬けにする それよりも睡眠を優先してしまいました🤭"
  },
  {
   "end_ms": "274895.00000000006",
   "start_ms": "268687",
   "start_time_text": "4:28",
   "text": "みそ・さとう・みりん・しょうゆ"
  },
  {
   "end_ms": "287744",
   "start_ms": "280993",
   "start_time_text": "4:40",
   "text": "水出しでも作れますが 麦茶は煮出した方がミネラルが豊富だそうです"
  },
  {
   "end_ms": "298282",
   "start_ms": "293508",
   "start_time_text": "4:53",
   "text": "朝一番にあったかい麦茶"
  },
  {
   "end_ms": "303847",
   "start_ms": "299328",
   "start_time_text": "4:59",
   "text": "すぐに冷ました方が腐りにくいそうです"
  },
  {
   "end_ms": "313174",
   "start_ms": "308400",
   "start_time_text": "5:08",
   "text": "昨年は9月も真夏のようでしたが"
  },
  {
   "end_ms": "323265.99999999994",
   "start_ms": "315431",
   "start_time_text": "5:15",
   "text": "今年は暑くなく しっかり秋を感じられそうです"
  },
  {
   "end_ms": "332719.00000000006",
   "start_ms": "327244",
   "start_time_text": "5:27",
   "text": "気温が下がるとお弁当作りも気が楽です"
  },
  {
   "end_ms": "379415",
   "start_ms": "373430",
   "start_time_text": "6:13",
   "text": "夏に作った手作りめんつゆ ついに使い切ってしまいました"
  },
  {
   "end_ms": "388965.00000000006",
   "start_ms": "382533",
   "start_time_text": "6:22",
   "text": "はちみつ・ホワイトバルサミコ・オリーブオイル・塩こしょう"
  },
  {
   "end_ms": "401256",
   "start_ms": "394665",
   "start_time_text": "6:34",
   "text": "出汁と砂糖で煮て 最後にみりんと醤油で味付けます"
  },
  {
   "end_ms": "410000",
   "start_ms": "406096",
   "start_time_text": "6:46",
   "text": "お弁当に映える緑色のししとう"
  },
  {
   "end_ms": "421886",
   "start_ms": "417877",
   "start_time_text": "6:57",
   "text": "最近マイブームの小松菜です"
  },
  {
   "end_ms": "431753.99999999994",
   "start_ms": "424525",
   "start_time_text": "7:04",
   "text": "塩ゆでして醤油と鰹節 簡単ですが嬉しい副菜になります"
  },
  {
   "end_ms": "454356",
   "start_ms": "450315",
   "start_time_text": "7:30",
   "text": "お弁当にぴったりのさつまいも煮"
  },
  {
   "end_ms": "474182",
   "start_ms": "470173",
   "start_time_text": "7:50",
   "text": "焦げやすいので弱火で優しく・・・"
  },
  {
   "end_ms": "491734.00000000006",
   "start_ms": "486386",
   "start_time_text": "8:06",
   "text": "梨が出回り始めると 運動会を思い出します"
  },
  {
   "end_ms": "500519",
   "start_ms": "495139",
   "start_time_text": "8:15",
   "text": "運動会のお弁当 梨とブドウがお決まりでした"
  },
  {
   "end_ms": "510929.00000000006",
   "start_ms": "506187",
   "start_time_text": "8:26",
   "text": "お弁当用に小さめに🔪"
  },
  {
   "end_ms": "528195",
   "start_ms": "521731",
   "start_time_text": "8:41",
   "text": "しっとり柔らかく焼けた鶏肉"
  },
  {
   "end_ms": "543102",
   "start_ms": "539317",
   "start_time_text": "8:59",
   "text": "のり弁に"
  },
  {
   "end_ms": "554980",
   "start_ms": "548357",
   "start_time_text": "9:08",
   "text": "汁気を吸ってくれるので かつお節を下に入れるのが良いそうです"
  },
  {
   "end_ms": "569992.0000000001",
   "start_ms": "563815",
   "start_time_text": "9:23",
   "text": "今日もお弁当と同じメニューの朝ごはん"
  },
  {
   "end_ms": "578362",
   "start_ms": "571866",
   "start_time_text": "9:31",
   "text": "原材料が国産のトマトだけのトマトジュースをスーパーで見つけました"
  },
  {
   "end_ms": "589653",
   "start_ms": "581850",
   "start_time_text": "9:41",
   "text": "朝ごはんの前に一杯飲むのが最近のお気に入りです🥰"
  },
  {
   "end_ms": "601817",
   "start_ms": "595768",
   "start_time_text": "9:55",
   "text": "一晩漬けられませんでしたが しっかり味が付いてとても美味しかったです"
  },
  {
   "end_ms": "610000",
   "start_ms": "603564",
   "start_time_text": "10:03",
   "text": "目の前のお昼ご飯をもう食べたい・・・🤤"
  },
  {
   "end_ms": "629820",
   "start_ms": "624950",
   "start_time_text": "10:24",
   "text": "終わりのない洗い物"
  },
  {
   "end_ms": "640644",
   "start_ms": "633033",
   "start_time_text": "10:33",
   "text": "洗ってしまってまた出して これが日常なんだなと思います"
  },
  {
   "end_ms": "652617.0000000001",
   "start_ms": "644464",
   "start_time_text": "10:44",
   "text": "焦げ付いたフライパンは重曹を入れて一度沸かしています"
  },
  {
   "end_ms": "665707",
   "start_ms": "659020",
   "start_time_text": "10:59",
   "text": "汚れが浮いて こする手間を省けます"
  },
  {
   "end_ms": "685512",
   "start_ms": "679335",
   "start_time_text": "11:19",
   "text": "冷ましている間に いつものようにキッチンを片付けて"
  },
  {
   "end_ms": "713481",
   "start_ms": "708325",
   "start_time_text": "11:48",
   "text": "するりとコゲが落ちる瞬間が気持ちいいです"
  },
  {
   "end_ms": "729312",
   "start_ms": "723072",
   "start_time_text": "12:03",
   "text": "油を塗って仕上げます"
  },
  {
   "end_ms": "755431",
   "start_ms": "750657",
   "start_time_text": "12:30",
   "text": "冷蔵庫からおやつを掘り出して"
  },
  {
   "end_ms": "763595",
   "start_ms": "757960",
   "start_time_text": "12:37",
   "text": "ささやかでも癒しの効果は絶大です🍫"
  },
  {
   "end_ms": "781275.0000000001",
   "start_ms": "774748",
   "start_time_text": "12:54",
   "text": "ラテを持って行くことにしました"
  },
  {
   "end_ms": "818784",
   "start_ms": "812193",
   "start_time_text": "13:32",
   "text": "キッチンの床が家の中で一番汚れやすい気がします"
  },
  {
   "end_ms": "838888",
   "start_ms": "833094",
   "start_time_text": "13:53",
   "text": "ここがピカピカしていると嬉しいです🤭"
  },
  {
   "end_ms": "863312",
   "start_ms": "856370",
   "start_time_text": "14:16",
   "text": "昨年の今頃は ニット素材を着るなんて考えられなかったような気がします"
  },
  {
   "end_ms": "874040.9999999999",
   "start_ms": "868343",
   "start_time_text": "14:28",
   "text": "可愛い秋物を暑さに耐えて着ていた気がするのですが"
  },
  {
   "end_ms": "881615",
   "start_ms": "875789",
   "start_time_text": "14:35",
   "text": "今年は秋物をたくさん楽しめそうな涼しさで嬉しいです🍁"
  },
  {
   "end_ms": "891452",
   "start_ms": "883968",
   "start_time_text": "14:43",
   "text": "星のアクセサリーも最近のブームです🤭"
  },
  {
   "end_ms": "900300",
   "start_ms": "895048",
   "start_time_text": "14:55",
   "text": "夏の間よく風邪を引いてしまっていました😅"
  },
  {
   "end_ms": "910902",
   "start_ms": "903546",
   "start_time_text": "15:03",
   "text": "持ち歩き用にお昼の薬を分けることにしました"
  },
  {
   "end_ms": "927658",
   "start_ms": "913861",
   "start_time_text": "15:13",
   "text": "抗生剤、整腸剤、カルボシステイン、トラネキサム酸 よく処方されるのでお馴染みのメンバーとなっています"
  },
  {
   "end_ms": "934753",
   "start_ms": "929724",
   "start_time_text": "15:29",
   "text": "この夏は喉がずっと痛かったので はちみつのスプレーを買ってみました"
  },
  {
   "end_ms": "943474",
   "start_ms": "936691",
   "start_time_text": "15:36",
   "text": "チクチクとした使い心地 いかにも効きそうです"
  },
  {
   "end_ms": "969699.0000000001",
   "start_ms": "961259",
   "start_time_text": "16:01",
   "text": "セールの表示に釣られて洋服を買って帰りました"
  },
  {
   "end_ms": "977367.9999999999",
   "start_ms": "972626",
   "start_time_text": "16:12",
   "text": "セールのニットに秋物のスカート"
  },
  {
   "end_ms": "985196",
   "start_ms": "979753",
   "start_time_text": "16:19",
   "text": "セールを見に行くと やっぱり秋物が可愛く見えるんですよね🤭"
  },
  {
   "end_ms": "997679",
   "start_ms": "988920",
   "start_time_text": "16:28",
   "text": "色が落ち着いているので 夏物のニットですがこの時期にたくさん着られそうです😊"
  },
  {
   "end_ms": "1008568",
   "start_ms": "1001722",
   "start_time_text": "16:41",
   "text": "まだ衣替えはしないけど 少し秋っぽくなって嬉しい瞬間です"
  },
  {
   "end_ms": "1020000",
   "start_ms": "1012388",
   "start_time_text": "16:52",
   "text": "やっぱり似たものを買ってしまいます"
  },
  {
   "end_ms": "1032228.0000000001",
   "start_ms": "1023309",
   "start_time_text": "17:03",
   "text": "友人が使っていて真似して買ったハンガーです"
  },
  {
   "end_ms": "1047867",
   "start_ms": "1036047",
   "start_time_text": "17:16",
   "text": "伸長できて 真ん中は二本のバーがあります"
  },
  {
   "end_ms": "1057928",
   "start_ms": "1050603",
   "start_time_text": "17:30",
   "text": "鴨居にも掛けられるのが購入の決め手です"
  },
  {
   "end_ms": "1072260",
   "start_ms": "1063788",
   "start_time_text": "17:43",
   "text": "浴衣を吊るすのに使ってみました"
  },
  {
   "end_ms": "1079610",
   "start_ms": "1072955",
   "start_time_text": "17:52",
   "text": "着物ハンガーも持っているのですが こちらの方が使いやすそうです🤭"
  },
  {
   "end_ms": "1086481",
   "start_ms": "1081835",
   "start_time_text": "18:01",
   "text": "もこもこのサンダル"
  },
  {
   "end_ms": "1096764.0000000002",
   "start_ms": "1087718",
   "start_time_text": "18:07",
   "text": "ゴミ出しなど さっと外に出たい時によさそうで買ってみました"
  },
  {
   "end_ms": "1106729",
   "start_ms": "1101891",
   "start_time_text": "18:21",
   "text": "とてもあったかい"
  },
  {
   "end_ms": "1114397",
   "start_ms": "1108029",
   "start_time_text": "18:28",
   "text": "1000円だったのでいいお買い物ができました"
  },
  {
   "end_ms": "1130387",
   "start_ms": "1123445",
   "start_time_text": "18:43",
   "text": "立ち上がったついでにお風呂を準備します"
  },
  {
   "end_ms": "1167400",
   "start_ms": "1161478",
   "start_time_text": "19:21",
   "text": "冷蔵庫に嬉しいおやつがあります"
  },
  {
   "end_ms": "1183868",
   "start_ms": "1176639",
   "start_time_text": "19:36",
   "text": "夜ご飯を作る前に少しだけ休憩が必要🥰"
  },
  {
   "end_ms": "1200241",
   "start_ms": "1193044",
   "start_time_text": "19:53",
   "text": "自然乾燥させた食器の片づけから始めます"
  },
  {
   "end_ms": "1236940",
   "start_ms": "1230986",
   "start_time_text": "20:30",
   "text": "夏の暑い日に食べたいと思っていたレシピ"
  },
  {
   "end_ms": "1246107",
   "start_ms": "1239133",
   "start_time_text": "20:39",
   "text": "夏の終わりを感じ始めて慌てて作ります"
  },
  {
   "end_ms": "1260439",
   "start_ms": "1254007",
   "start_time_text": "20:54",
   "text": "今日のメインのじゅんさいです"
  },
  {
   "end_ms": "1270658.0000000002",
   "start_ms": "1265055",
   "start_time_text": "21:05",
   "text": "食べたことはあるけど 買ったのは初めて"
  },
  {
   "end_ms": "1284034",
   "start_ms": "1276996",
   "start_time_text": "21:16",
   "text": "味玉に使っためんつゆを使ってしまいます"
  },
  {
   "end_ms": "1306643",
   "start_ms": "1301837",
   "start_time_text": "21:41",
   "text": "みょうがと大葉"
  },
  {
   "end_ms": "1314120.9999999998",
   "start_ms": "1307434",
   "start_time_text": "21:47",
   "text": "一年中食べられるけど やっぱり夏に食べ収めたいです🤭"
  },
  {
   "end_ms": "1330270.0000000002",
   "start_ms": "1324380",
   "start_time_text": "22:04",
   "text": "生姜・にんにく・酒・醤油・塩"
  },
  {
   "end_ms": "1340904",
   "start_ms": "1336162",
   "start_time_text": "22:16",
   "text": "卵・水・薄力粉・片栗粉"
  },
  {
   "end_ms": "1349721",
   "start_ms": "1344979",
   "start_time_text": "22:24",
   "text": "残り一束になっていた蕎麦"
  },
  {
   "end_ms": "1411309",
   "start_ms": "1404144",
   "start_time_text": "23:24",
   "text": "もし揚げ物をしたら 必ずその場で揚げたてを食べてください🤭"
  },
  {
   "end_ms": "1419282",
   "start_ms": "1413615",
   "start_time_text": "23:33",
   "text": "プシュッとビールを開けてもいいと思います🤭"
  },
  {
   "end_ms": "1429628",
   "start_ms": "1423388",
   "start_time_text": "23:43",
   "text": "無性に食べたくなった とり天と大葉の天ぷらです"
  },
  {
   "end_ms": "1443833",
   "start_ms": "1437497",
   "start_time_text": "23:57",
   "text": "よく冷やしたそばにじゅんさいをのせて"
  },
  {
   "end_ms": "1455540",
   "start_ms": "1450001",
   "start_time_text": "24:10",
   "text": "さっぱり冷たい蕎麦ととり天のセットです"
  },
  {
   "end_ms": "1464420",
   "start_ms": "1457319",
   "start_time_text": "24:17",
   "text": "（何かしたわけではないのですが） ご褒美のメロンエール"
