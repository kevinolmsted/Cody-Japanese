   "end_ms": "1572296",
   "start_ms": "1565960",
   "start_time_text": "26:05",
   "text": "日本の店舗てセールをしていたので お買い物しました"
  },
  {
   "end_ms": "1579519",
   "start_ms": "1575765",
   "start_time_text": "26:15",
   "text": "スカルプスプレー"
  },
  {
   "end_ms": "1590216.0000000002",
   "start_ms": "1582987",
   "start_time_text": "26:22",
   "text": "潤いを与えてくれるのですが ベタつかない使い心地が気に入りました"
  },
  {
   "end_ms": "1600000",
   "start_ms": "1592154",
   "start_time_text": "26:32",
   "text": "自然に還る歯磨き粉 キャンプなどで使うのにも人気だそうです"
  },
  {
   "end_ms": "1607274",
   "start_ms": "1601034",
   "start_time_text": "26:41",
   "text": "シャンプーは種類がたくさんあったので 香りで選んでみました"
  },
  {
   "end_ms": "1614591.9999999998",
   "start_ms": "1608830",
   "start_time_text": "26:48",
   "text": "長らくズボラ生活をしていたことのひとつ"
  },
  {
   "end_ms": "1623919",
   "start_ms": "1616690",
   "start_time_text": "26:56",
   "text": "詰め替え用の袋のまま洗剤を使っていました😂"
  },
  {
   "end_ms": "1634425",
   "start_ms": "1626367",
   "start_time_text": "27:06",
   "text": "ギュッと押して量れるるボトルにしました"
  },
  {
   "end_ms": "1648582.9999999998",
   "start_ms": "1642916",
   "start_time_text": "27:22",
   "text": "いつもと違うアイテムが並んで いい気分転換に"
  },
