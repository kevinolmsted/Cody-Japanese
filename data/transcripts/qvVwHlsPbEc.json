   "end_ms": "1664509",
   "start_ms": "1656451",
   "start_time_text": "27:36",
   "text": "オイルも酸化してしまうので 使い切ってしまうことにしました"
  },
  {
   "end_ms": "1688614",
   "start_ms": "1680046",
   "start_time_text": "28:00",
   "text": "使い心地もよかったのですが 香りも強すぎず気に入りました"
  },
  {
   "end_ms": "1712812.9999999998",
   "start_ms": "1704819",
   "start_time_text": "28:24",
   "text": "美味しい冷たい飲み物も飲み納めていかないと"
  },
