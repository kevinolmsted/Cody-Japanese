   "end_ms": "1531173",
   "start_ms": "1523912",
   "start_time_text": "25:23",
   "text": "また忙しい季節の変わり目です"
  },
  {
   "end_ms": "1544301",
   "start_ms": "1536466",
   "start_time_text": "25:36",
   "text": "ドラマ、YouTube、音楽、考え事 何かをしながら洗い物をするのが好きです"
  },
  {
   "end_ms": "1553755",
   "start_ms": "1548853",
   "start_time_text": "25:48",
   "text": "キッチンを片付けて お風呂で温まります"
  },
  {
   "end_ms": "1563990",
   "start_ms": "1558036",
   "start_time_text": "25:58",
   "text": "台湾旅行で気になった ワインボトルのようなシャンプー"
  },
