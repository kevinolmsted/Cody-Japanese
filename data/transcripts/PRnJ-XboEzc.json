 "transcript": [
  {
   "end_ms": "17098",
   "start_ms": "12038",
   "start_time_text": "0:12",
   "text": "今日は結構早く目が覚めて現在5:34"
  },
  {
   "end_ms": "25116",
   "start_ms": "20056",
   "start_time_text": "0:20",
   "text": "最近起きる時間が7時くらいになりつつあったけど"
  },
  {
   "end_ms": "30380",
   "start_ms": "25320",
   "start_time_text": "0:25",
   "text": "少し日にちが経つと勝手に早起きサイクルに戻ります😂"
  },
  {
   "end_ms": "38556",
   "start_ms": "33238",
   "start_time_text": "0:33",
   "text": "寒いから首周りを温めて全身ぽかぽかになろうの会。"
  },
  {
   "end_ms": "45088",
   "start_ms": "39770",
   "start_time_text": "0:39",
   "text": "急にカフェスペースが欲しくなって場所を開けてみた。"
  },
  {
   "end_ms": "50690.99999999999",
   "start_ms": "45373",
   "start_time_text": "0:45",
   "text": "でもなんとな〜くしっくりこない。"
  },
  {
   "end_ms": "56565.00000000001",
   "start_ms": "51246",
   "start_time_text": "0:51",
   "text": "朝の水分補給をしながら思案してみよう。"
  },
  {
   "end_ms": "62120.00000000001",
   "start_ms": "56801",
   "start_time_text": "0:56",
   "text": "せっかく早起きしたし朝時間を有意義に使おう😌🌿"
  },
  {
   "end_ms": "73345",
   "start_ms": "68026",
   "start_time_text": "1:08",
   "text": "あっちあちだけど本当にこれ1つで全身温まる。"
  },
  {
   "end_ms": "78883",
   "start_ms": "73565",
   "start_time_text": "1:13",
   "text": "肩こりも酷いけど冷え性も大概酷いから気持ちいい。"
  },
  {
   "end_ms": "84436",
   "start_ms": "79118",
   "start_time_text": "1:19",
   "text": "是非継続して定期的に使いたいのについ忘れちゃいます。"
  },
  {
   "end_ms": "90680",
   "start_ms": "85780",
   "start_time_text": "1:25",
   "text": "今日のやりたいことを軽く書いたら"
  },
  {
   "end_ms": "96180",
   "start_ms": "90905",
   "start_time_text": "1:30",
   "text": "軽くキッチンの模様替え計画も考えてみます☺️"
  },
  {
   "end_ms": "101335",
   "start_ms": "96871",
   "start_time_text": "1:36",
   "text": "寒くて体ガチガチ。"
  },
  {
   "end_ms": "106871.00000000001",
   "start_ms": "101596",
   "start_time_text": "1:41",
   "text": "3日坊主でもらやらないより良いからストレッチ。"
  },
  {
   "end_ms": "112435",
   "start_ms": "107160",
   "start_time_text": "1:47",
   "text": "伸ばしたい場所だけ伸ばるだけの軽いストレッチです。"
  },
  {
   "end_ms": "123128",
   "start_ms": "117853",
   "start_time_text": "1:57",
   "text": "朝の時間はうっかりスマホ見過ぎちゃうな。"
  },
  {
   "end_ms": "129026.00000000001",
   "start_ms": "123280",
   "start_time_text": "2:03",
   "text": "インテリアとか雑貨は特に見始めると終わりが見えません😂"
  },
  {
   "end_ms": "134596",
   "start_ms": "129321",
   "start_time_text": "2:09",
   "text": "まだまだ可愛いをアプデしたい😌🌿"
  },
  {
   "end_ms": "142484.99999999997",
   "start_ms": "137166",
   "start_time_text": "2:17",
   "text": "しっくり来てないけど一旦カフェスペースとして使ってみる"
  },
  {
   "end_ms": "147921.00000000003",
   "start_ms": "142603",
   "start_time_text": "2:22",
   "text": "一旦使ってみてイメージ沸かせて色々置こう。"
  },
  {
   "end_ms": "158578",
   "start_ms": "153260",
   "start_time_text": "2:33",
   "text": "のつもりだったけど、ふいに思いついた。"
  },
  {
   "end_ms": "164148.00000000003",
   "start_ms": "158830",
   "start_time_text": "2:38",
   "text": "大幅に家電の置き場所も変えてしまおう☝🏻"
  },
  {
   "end_ms": "171133",
   "start_ms": "164383",
   "start_time_text": "2:44",
   "text": "まあ、模様替えなら元に戻すにも アップデートするのも簡単だし"
  },
  {
   "end_ms": "176728",
   "start_ms": "171410",
   "start_time_text": "2:51",
   "text": "模様替えってお金がかからないから"
  },
  {
   "end_ms": "182225",
   "start_ms": "176906",
   "start_time_text": "2:56",
   "text": "手軽に気分が変えられて大好き☺️💖"
  },
  {
   "end_ms": "189688.00000000003",
   "start_ms": "184370",
   "start_time_text": "3:04",
   "text": "一旦炊飯器のことは忘れよう。"
  },
  {
   "end_ms": "206045",
   "start_ms": "200726",
   "start_time_text": "3:20",
   "text": "配置を真逆に変えてみたら意外といい感じ。"
  },
  {
   "end_ms": "212253",
   "start_ms": "206935",
   "start_time_text": "3:26",
   "text": "あんまり活用できてなかったこのトレイも使います。"
  },
  {
   "end_ms": "217796.00000000003",
   "start_ms": "212478",
   "start_time_text": "3:32",
   "text": "いまいちうまく使えてなかったから居場所ができて嬉しい🤭"
  },
  {
   "end_ms": "233929.99999999997",
   "start_ms": "228611",
   "start_time_text": "3:48",
   "text": "配線が気になるから絵を飾りたい。"
  },
  {
   "end_ms": "239260.00000000003",
   "start_ms": "234281",
   "start_time_text": "3:54",
   "text": "持ってて余らせていたトムジェリのポスター。"
  },
  {
   "end_ms": "243736.00000000003",
   "start_ms": "239330",
   "start_time_text": "3:59",
   "text": "ちょっとそれっぼくなったかも🤭"
  },
  {
   "end_ms": "248401",
   "start_ms": "243995",
   "start_time_text": "4:03",
   "text": "結構いいかも！"
  },
  {
   "end_ms": "254815",
   "start_ms": "248776",
   "start_time_text": "4:08",
   "text": "炊飯器はカウンターに置くことにしました。 ちょっと使いにくいけど😂"
  },
  {
   "end_ms": "260438",
   "start_ms": "255330",
   "start_time_text": "4:15",
   "text": "今後アプデするかもです🕺🏻"
  },
  {
   "end_ms": "266868",
   "start_ms": "261118",
   "start_time_text": "4:21",
   "text": "7時前から1時間強も模様替えしてたからお腹ぺこぺこ😂"
  },
  {
   "end_ms": "273881",
   "start_ms": "267528",
   "start_time_text": "4:27",
   "text": "今日は萌え段目指してサンドイッチを作ります🥪"
  },
  {
   "end_ms": "283826",
   "start_ms": "277675",
   "start_time_text": "4:37",
   "text": "パンはいつでもロイヤルブレッド派🫰🏻"
  },
  {
   "end_ms": "294205",
   "start_ms": "288053",
   "start_time_text": "4:48",
   "text": "目玉焼きは両面焼きで中心だけ少しとろっとなればベスト🍳"
  },
  {
   "end_ms": "301804.99999999994",
   "start_ms": "296203",
   "start_time_text": "4:56",
   "text": "パンにはバターとお好みでマスタードを塗ります。"
  },
  {
   "end_ms": "309285",
   "start_ms": "301961",
   "start_time_text": "5:01",
   "text": "私はマスタード得意じゃないから塗らないけど 塗る方が美味しいってよく言うよね？🤣"
  },
  {
   "end_ms": "315270.00000000006",
   "start_ms": "309463",
   "start_time_text": "5:09",
   "text": "大きめにちぎったレタスをこれでもかってほど乗せて"
  },
  {
   "end_ms": "320857.99999999994",
   "start_ms": "315578",
   "start_time_text": "5:15",
   "text": "そこにトマト、少し小さめだから2切れ。"
  },
  {
   "end_ms": "325188",
   "start_ms": "321046",
   "start_time_text": "5:21",
   "text": "真ん中にまたパン"
  },
  {
   "end_ms": "330776",
   "start_ms": "325378",
   "start_time_text": "5:25",
   "text": "両面焼きした目玉焼きと最後にハムを乗せたら"
  },
  {
   "end_ms": "336373.00000000006",
   "start_ms": "330975",
   "start_time_text": "5:30",
   "text": "ボリュームたっぷりのサンドイッチの完成✨"
  },
  {
   "end_ms": "351656",
   "start_ms": "346258",
   "start_time_text": "5:46",
   "text": "ラップに少しきつめに包んで少しの間だけ休ませておきます。"
  },
  {
   "end_ms": "357371.00000000006",
   "start_ms": "351973",
   "start_time_text": "5:51",
   "text": "少し待ったほうが野菜の水分がパンに吸って少し馴染みます。"
  },
  {
   "end_ms": "370373.00000000006",
   "start_ms": "364975",
   "start_time_text": "6:04",
   "text": "さっそくここでコーヒーを淹れてみる☕️"
  },
  {
   "end_ms": "381750",
   "start_ms": "376351",
   "start_time_text": "6:16",
   "text": "専用の場所があるってだけでめっちゃ気分上がるなぁ🕺🏻"
  },
  {
   "end_ms": "387465",
   "start_ms": "382066",
   "start_time_text": "6:22",
   "text": "あ〜スチーマーの付いたコーヒーメーカーが欲しいっ！"
  },
  {
   "end_ms": "398028",
   "start_ms": "392630",
   "start_time_text": "6:32",
   "text": "萌えになってるか！いかに！"
  },
  {
   "end_ms": "404948",
   "start_ms": "401150",
   "start_time_text": "6:41",
   "text": "うおおお！大成功すぎる！！"
  },
  {
   "end_ms": "410688.00000000006",
   "start_ms": "405160",
   "start_time_text": "6:45",
   "text": "若干レタス盛りすぎな気もするけど許容範囲内だよね！"
  },
  {
   "end_ms": "417087.99999999994",
   "start_ms": "411111",
   "start_time_text": "6:51",
   "text": "カラフルで卵もめっちゃちょうど良くできてる🤭"
  },
  {
   "end_ms": "422811.00000000006",
   "start_ms": "417860",
   "start_time_text": "6:57",
   "text": "やばい....かわいい...."
  },
  {
   "end_ms": "433370",
   "start_ms": "429620",
   "start_time_text": "7:09",
   "text": "いただきます✨"
  },
  {
   "end_ms": "441493",
   "start_ms": "436243",
   "start_time_text": "7:16",
   "text": "ボリューミーだけど野菜たっぷりだから罪悪感少なめ！"
  },
  {
   "end_ms": "447151",
   "start_ms": "441901",
   "start_time_text": "7:21",
   "text": "顎が小さい人は食べるのきつそうなくらい分厚いけど"
  },
  {
   "end_ms": "452661",
   "start_ms": "447411",
   "start_time_text": "7:27",
   "text": "さっぱりでおいし〜！"
  },
  {
   "end_ms": "461213",
   "start_ms": "455963",
   "start_time_text": "7:35",
   "text": "ハムを多めに入れたから食べ応えがあるけど"
  },
  {
   "end_ms": "466636",
   "start_ms": "461386",
   "start_time_text": "7:41",
   "text": "レタスとトマトが野菜感増し増しで最高🤤"
  },
  {
   "end_ms": "482756",
   "start_ms": "477506",
   "start_time_text": "7:57",
   "text": "アイビー、水捌け最悪なのに元気すぎる🌿"
  },
  {
   "end_ms": "488145",
   "start_ms": "482895",
   "start_time_text": "8:02",
   "text": "散らかしたテーブルの上をかるーく片付けて"
  },
  {
   "end_ms": "495010",
   "start_ms": "490913",
   "start_time_text": "8:10",
   "text": "今日はゲーム楽しむぞ〜✊🏻"
  },
  {
   "end_ms": "500321",
   "start_ms": "495190",
   "start_time_text": "8:15",
   "text": "と、思ったけどやっぱり片付け再開😌"
  },
  {
   "end_ms": "505566.00000000006",
   "start_ms": "500435",
   "start_time_text": "8:20",
   "text": "さっきのカフェスペース作りでこの収納を空けたので"
  },
  {
   "end_ms": "510821",
   "start_ms": "505690",
   "start_time_text": "8:25",
   "text": "無理矢理缶に入れてたものたちをこっちに移動！"
  },
  {
   "end_ms": "516125",
   "start_ms": "510993",
   "start_time_text": "8:30",
   "text": "なるべく動かずに色々取れるようにしておきたい🤣"
  },
  {
   "end_ms": "521040.99999999994",
   "start_ms": "516510.99999999994",
   "start_time_text": "8:36",
   "text": "今まで缶はテーブルに置いてたけどこれは大きめだから"
  },
  {
   "end_ms": "525189.9999999999",
   "start_ms": "521212.99999999994",
   "start_time_text": "8:41",
   "text": "ソファの下に隠します🛋️笑"
  },
  {
   "end_ms": "531090",
   "start_ms": "525400",
   "start_time_text": "8:45",
   "text": "これでゲームに集中できる🕺🏻"
  },
  {
   "end_ms": "537545.0000000001",
   "start_ms": "531855",
   "start_time_text": "8:51",
   "text": "最近手持ちでやってるときは大体逆転裁判やってます。"
  },
  {
   "end_ms": "548585",
   "start_ms": "542895",
   "start_time_text": "9:02",
   "text": "モニターに向かってゲームするぞ！ってときは"
  },
  {
   "end_ms": "555635",
   "start_ms": "549040",
   "start_time_text": "9:09",
   "text": "ガッツリRPGとか推しゲームする気分だから 軽いゲームする気にならなくて"
  },
  {
   "end_ms": "561608.0000000001",
   "start_ms": "555918",
   "start_time_text": "9:15",
   "text": "都市伝説解体センターをSteamで買ったのを後悔してます😇"
  },
  {
   "end_ms": "567593.0000000001",
   "start_ms": "561903",
   "start_time_text": "9:21",
   "text": "（買ったときはSteamでセールしてたの...よ...）"
  },
  {
   "end_ms": "575245",
   "start_ms": "571083",
   "start_time_text": "9:31",
   "text": "ゆるくできるゲームも重めなゲームもどっちも大好き🎮"
  },
  {
   "end_ms": "576491",
   "start_ms": "575245",
   "start_time_text": "9:35",
   "text": "前髪とっ散らかってる"
  },
  {
   "end_ms": "582076",
   "start_ms": "576491",
   "start_time_text": "9:36",
   "text": "逆裁ちょっとずつしか進めてなくて終わり見えない😂"
  },
  {
   "end_ms": "591231",
   "start_ms": "585646",
   "start_time_text": "9:45",
   "text": "今日暖かくてアイスドリンクが飲みたくなる🌷"
  },
  {
   "end_ms": "597101",
   "start_ms": "591516",
   "start_time_text": "9:51",
   "text": "安定のアイスオレにしましょ。"
  },
  {
   "end_ms": "604438",
   "start_ms": "598370",
   "start_time_text": "9:58",
   "text": "そろそろラテも飲まないと、 インスタントがダメになってしまう...笑"
  },
  {
   "end_ms": "610290.0000000001",
   "start_ms": "604705",
   "start_time_text": "10:04",
   "text": "もともと薄味派だけど年々さらに薄味派になってます😂"
  },
  {
   "end_ms": "615966",
   "start_ms": "610683",
   "start_time_text": "10:10",
   "text": "だから濃いラテよりオレにしちゃう。"
  },
  {
   "end_ms": "621570",
   "start_ms": "616105",
   "start_time_text": "10:16",
   "text": "前はラテ派だったのになぁ、味覚変わってきてる😌"
  },
  {
   "end_ms": "625683",
   "start_ms": "621826",
   "start_time_text": "10:21",
   "text": "これが、大人になるってやつ....??"
  },
  {
   "end_ms": "631175",
   "start_ms": "625990",
   "start_time_text": "10:25",
   "text": "日焼けしそうだけど陽に当たるのだいすき。"
  },
  {
   "end_ms": "636704.9999999999",
